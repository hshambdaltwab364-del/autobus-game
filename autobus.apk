function getBankValue(letter, key){
 if(key==="country" && COUNTRY_BANK[letter] && COUNTRY_BANK[letter].length){
   const arr=COUNTRY_BANK[letter]; return arr[Math.floor(Math.random()*arr.length)];
 }
 if(key==="boy" && BOY_BANK[letter] && BOY_BANK[letter].length){
   const arr=BOY_BANK[letter]; return arr[Math.floor(Math.random()*arr.length)];
 }
 if(key==="girl" && GIRL_BANK[letter] && GIRL_BANK[letter].length){
   const arr=GIRL_BANK[letter]; return arr[Math.floor(Math.random()*arr.length)];
 }
 if(key==="animal" && ANIMAL_BANK[letter] && ANIMAL_BANK[letter].length){
   const arr=ANIMAL_BANK[letter]; return arr[Math.floor(Math.random()*arr.length)];
 }
 if(key==="thing" && THING_BANK[letter] && THING_BANK[letter].length){
   const arr=THING_BANK[letter]; return arr[Math.floor(Math.random()*arr.length)];
 }
 if(key==="plant" && PLANT_BANK[letter] && PLANT_BANK[letter].length){
   const arr=PLANT_BANK[letter]; return arr[Math.floor(Math.random()*arr.length)];
 }
 if(BANK[letter] && BANK[letter][key]) return BANK[letter][key];
 return "";
}

