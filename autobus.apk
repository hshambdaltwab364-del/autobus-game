<title>أتوبيس 🚌 - للأندرويد - العب أونلاين مع صحابك</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%;-webkit-tap-highlight-color:transparent} body{font-family:'Segoe UI',Tahoma,Arial,sans-serif,-apple-system,BlinkMacSystemFont;background:#1a0f0a;color:#241a12;min-height:100vh;min-height:100dvh;padding:10px 10px calc(40px + env(safe-area-inset-bottom));padding-top:calc(10px + env(safe-area-inset-top));direction:rtl;overscroll-behavior-y:none;-webkit-overflow-scrolling:touch} input,select,textarea{font-size:16px!important}
  /* v61: أندرويد بس - لوحة مفاتيح، مساحة آمنة، لمس */
  html{scrollbar-width:thin} body{padding-bottom:calc(12px + env(safe-area-inset-bottom));-webkit-tap-highlight-color:transparent}
  .btn{min-height:48px} input{caret-color:#ff5a3c}
  @media (max-width:380px){ .grid{grid-template-columns:1fr 1fr} h1{font-size:26px} .btn{font-size:15px} }
  @supports (-webkit-touch-callout:none){ body{-webkit-user-select:none;user-select:none} input,textarea{-webkit-user-select:text;user-select:text} } button,.btn{touch-action:manipulation;-webkit-appearance:none;appearance:none;user-select:none;-webkit-user-select:none} img{-webkit-user-drag:none}
#app{max-width:560px;margin:0 auto}
.card{background:#fff8ee;border-radius:20px;padding:16px;margin-bottom:12px;box-shadow:0 4px 14px rgba(0,0,0,.25)}
h1{font-size:30px;text-align:center}h2{font-size:22px}h3{font-size:18px;margin-bottom:6px}
.sub{text-align:center;color:#7a5a3a;font-size:13px;margin:4px 0 10px}
.small{font-size:12px;color:#7a5a3a}.center{text-align:center}
label{display:block;font-size:13px;font-weight:700;margin:10px 0 4px}
input,select,textarea{width:100%;padding:12px;border:2px solid #e8d5b5;border-radius:12px;font-size:15px;font-family:inherit;background:#fff;margin-bottom:6px}
.btn{display:block;width:100%;padding:13px;border:none;border-radius:14px;font-size:16px;font-weight:900;cursor:pointer;margin-top:8px;background:#241a12;color:#fff;transition:transform .1s}
.btn:active{transform:scale(.97)}.btn:disabled{opacity:.5}
.btn-green{background:#25b84a;color:#fff}.btn-red{background:#e23b2e;color:#fff}.btn-white{background:#fff;color:#241a12;border:2px solid #e8d5b5}
.btn-blue{background:#0b5cff;color:#fff}.btn-purple{background:#7c5cff;color:#fff}
.badge{display:inline-block;background:#ff5a3c;color:#fff;border-radius:20px;padding:2px 9px;font-size:12px;font-weight:900}
.shop-item{display:flex;justify-content:space-between;align-items:center;gap:8px;background:#fff;border:2px solid #f0e0c8;border-radius:14px;padding:10px;margin-top:8px}
.hero{background:linear-gradient(135deg,#ff9a3c,#ff5a3c);color:#fff;border-radius:20px;padding:16px;margin-bottom:12px;text-align:center}
.hero h1{color:#fff}.hero .sub{color:#ffe8d5}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.grid .btn{margin:0;font-size:14px}
.avatar-wrap{width:74px;height:74px;border-radius:50%;background:#ffe8c8;display:flex;align-items:center;justify-content:center;font-size:34px;overflow:visible;border:3px solid #ff9a3c;flex-shrink:0;position:relative} .avatar-wrap img{border-radius:50%;width:100%;height:100%;object-fit:cover} .avatar-wrap::after{position:absolute;bottom:-14px;right:50%;transform:translateX(50%);width:auto;height:auto;background:transparent;display:none;align-items:center;justify-content:center;font-size:30px;box-shadow:none;border:none;line-height:1;z-index:3;filter:drop-shadow(0 2px 3px #0005)} .avatar-wrap[class*='frame-']::after{display:flex}
.avatar-wrap img{width:100%;height:100%;object-fit:cover}
.frame-hug_dragon{border:4px solid #0f5132!important;box-shadow:0 0 0 2px #ffd700,0 0 0 6px #0f5132,0 0 22px #0f513266,0 6px 18px #0003} .frame-hug_dragon::after{content:"🐉"}
.frame-hug_panda{border:4px solid #111!important;box-shadow:0 0 0 2px #fff,0 0 0 6px #111,0 0 22px #0008,0 6px 18px #0003} .frame-hug_panda::after{content:"🐼"}
.frame-hug_tiger{border:4px solid #ff6a00!important;box-shadow:0 0 0 2px #111,0 0 0 6px #ff6a00,0 0 22px #ff6a00aa,0 6px 18px #0003} .frame-hug_tiger::after{content:"🐯"}
.frame-hug_lion{border:4px solid #ffb800!important;box-shadow:0 0 0 2px #fff,0 0 0 6px #ffb800,0 0 22px #ffb800aa,0 6px 18px #0003} .frame-hug_lion::after{content:"🦁"}
.frame-hug_wolf{border:4px solid #334155!important;box-shadow:0 0 0 2px #cbd5e1,0 0 0 6px #334155,0 0 22px #33415599,0 6px 18px #0003} .frame-hug_wolf::after{content:"🐺"}
.frame-hug_eagle{border:4px solid #0b3d91!important;box-shadow:0 0 0 2px #fff,0 0 0 6px #0b3d91,0 0 22px #0b3d9199,0 6px 18px #0003} .frame-hug_eagle::after{content:"🦅"}
.frame-hug_butterfly{border:4px solid #ff8fab!important;box-shadow:0 0 0 2px #fff,0 0 0 6px #ff8fab,0 0 22px #ff8fab99,0 6px 18px #0003} .frame-hug_butterfly::after{content:"🦋"}
.frame-hug_shark{border:4px solid #0ea5e9!important;box-shadow:0 0 0 2px #fff,0 0 0 6px #0ea5e9,0 0 22px #0ea5e999,0 6px 18px #0003} .frame-hug_shark::after{content:"🦈"}
.frame-hug_peacock{border:4px solid #0077b6!important;box-shadow:0 0 0 2px #ffd700,0 0 0 6px #0077b6,0 0 22px #0077b699,0 6px 18px #0003} .frame-hug_peacock::after{content:"🦚"}
.frame-hug_fox{border:4px solid #f97316!important;box-shadow:0 0 0 2px #fff,0 0 0 6px #f97316,0 0 22px #f9731699,0 6px 18px #0003} .frame-hug_fox::after{content:"🦊"} .frame-phoenix::after{content:"🔥"}
.chat{max-height:300px;overflow-y:auto;background:#fff;border:2px solid #f0e0c8;border-radius:14px;padding:10px;margin-top:8px}
.msg{margin-bottom:8px;background:#f7ecdc;border-radius:12px;padding:8px 10px;word-break:break-word}
.msg.me{background:#d9f7df}.msg .t{font-size:11px;color:#888}
.timer{font-size:34px;font-weight:900;text-align:center;color:#e23b2e}
.letter-big{font-size:64px;font-weight:900;text-align:center;color:#ff5a3c}
.pill{display:inline-block;background:#f0e0c8;border-radius:20px;padding:4px 12px;font-size:13px;font-weight:700;margin:2px}
.net-dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:#e23b2e;margin-left:6px}
.net-dot.on{background:#25b84a}
#toastWrap{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:9999;display:flex;flex-direction:column;gap:6px;align-items:center;pointer-events:none;width:94%;max-width:480px}
.toast{background:#241a12;color:#fff;padding:12px 16px;border-radius:14px;font-size:14px;font-weight:700;text-align:center;box-shadow:0 4px 14px rgba(0,0,0,.4);animation:tin .2s}
@keyframes tin{from{opacity:0;transform:translateY(8px)}}
.ans-row{display:flex;justify-content:space-between;gap:8px;padding:8px;border-bottom:1px solid #f0e0c8;font-size:14px}
.ans-row b{color:#25b84a}.ans-row .bad{color:#e23b2e}
.kbd{font-size:11px;background:#f0e0c8;border-radius:6px;padding:1px 6px}
</style>
</head>
<body>
<div id="app"><div class="card center"><h1>🚌 أتوبيس</h1><p class="small">بيحمّل...</p><p class="small" style="margin-top:10px">لو فضل بيحمّل أكتر من 5 ثواني، دوس هنا:</p><button class="btn btn-green" onclick="window.__forceOpen&&window.__forceOpen()" style="margin-top:6px">🔄 افتح اللعبة</button><p class="small" style="margin-top:8px">⚠️ افتح الملف من <b>Chrome</b> مش من عارض الملفات - العارض بيمنع اللعبة تشتغل.</p></div></div>
<div id="toastWrap"></div>
<script>
"use strict";
// أتوبيس 🚌 - من صنع Hesham Etsh - جميع الحقوق محفوظة - ليس من إنشاء أي شركة أخرى
// v61: أندرويد بس + أونلاين 100% - فحص الاتصال، تحذير file://، فتح الصوت
window.addEventListener("online", ()=>{ netOn=true; try{ toast("✅ رجع النت - انت أونلاين"); }catch(e){} try{ if(view==="home") render(); }catch(e){} });
window.addEventListener("offline", ()=>{ netOn=false; try{ toast("❌ النت فصل - اللعبة محتاجة نت عشان تلعب أونلاين"); }catch(e){} });
document.addEventListener("touchstart", function unlockAudio(){ try{ if(_audioCtx && _audioCtx.state==="suspended") _audioCtx.resume(); }catch(e){} }, {once:true, passive:true});
document.addEventListener("click", function unlockAudio2(){ try{ if(!_audioCtx) _audioCtx=new (window.AudioContext||window.webkitAudioContext)(); if(_audioCtx.state==="suspended") _audioCtx.resume(); }catch(e){} }, {once:true});
if(location.protocol==="file:"){ setTimeout(()=>{ try{ const app=document.getElementById("app"); if(app && !document.getElementById("fileWarn")){ const d=document.createElement("div"); d.id="fileWarn"; d.style.cssText="background:#fff3cd;border:2px solid #ffc23d;border-radius:14px;padding:10px;margin:10px auto;max-width:560px;text-align:center;font-size:13px"; d.innerHTML="⚠️ انت فاتح الملف من <b>عارض الملفات</b> - افتحه من <b>Chrome</b> على الأندرويد. التطبيق مخصص للأندرويد بس."; app.parentNode.insertBefore(d, app); } }catch(e){} }, 1500); }
window.addEventListener("error", function(e){ try{ const app=document.getElementById("app"); if(app && app.innerHTML.includes("بيحمّل")){ app.innerHTML='<div class="card center"><h2>🚌 أتوبيس</h2><p class="small">حصلت مشكلة في فتح الملف.</p><p class="small">افتحه من <b>Chrome</b> مش من عارض الملفات.<br>لو فتحته من Chrome ولسه المشكلة موجودة، امسح الكاش ودوس تحديث.</p><button class="btn btn-green" onclick="location.reload()">🔄 حاول تاني</button></div>'; } }catch(err){} });
