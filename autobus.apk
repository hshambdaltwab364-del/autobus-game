  <label>🔒 كلمة السر</label><div style="display:flex;gap:6px"><input id="authPass" type="password" placeholder="اكتب كلمة السر" maxlength="30" autocomplete="current-password" style="flex:1;margin:0"><button class="btn btn-white" id="btnTogglePass" style="width:52px;margin:0;font-size:18px" title="إظهار / إخفاء">👁️</button></div>
  <p class="small" style="margin:4px 0 0">دوس 👁️ عشان تشوف كلمة السر اللي كتبتها - أغلب مشاكل الدخول بتبقى حرف زيادة أو ناقص وانت مش شايفه</p>
  <button class="btn btn-green" id="btnCreate">🆕 اعمل حساب جديد</button>
  <button class="btn btn-blue" id="btnLogin">🔑 دخول بحساب قديم</button>
   <button class="btn btn-white" id="btnGoRecover">🔑 نسيت كلمة السر؟</button>
  <p class="small center" style="margin-top:10px">للدخول: اكتب اسمك أو الـ ID + كلمة السر ودوس <b>دخول بحساب قديم</b>.</p>
   <div style="background:#eaf7ff;border:2px solid #0b5cff;border-radius:14px;padding:10px;margin-top:10px"><b>📧 مش عارف تدخل؟</b><p class="small">لو نسيت كلمة السر أو الاسم أو الـ ID، ابعت للمالك على البريد من هنا، وهو هيبعتلك بيانات حسابك.</p><a href="mailto:${EMAIL}?subject=مش عارف ادخل حسابي - أتوبيس&body=اكتب هنا الاسم أو الـ ID اللي فاكره:%0A%0Aالاسم:%0Aالـ ID:%0A" style="display:block;text-align:center;background:#0b5cff;color:#fff;font-weight:900;border-radius:12px;padding:12px;margin-top:8px;text-decoration:none">📧 ابعت للمالك على البريد</a><p class="small center" style="margin:6px 0 0">${EMAIL}</p><button class="btn btn-white" id="btnCopyEmailAuth" style="margin-top:6px">📋 انسخ البريد</button></div>
  <div style="background:#f0eaff;border:1px dashed #7c5cff;border-radius:14px;padding:10px;margin-top:10px">
  <b>🔄 عندك حساب من النسخة القديمة؟</b><p class="small">اكتب الـ ID القديم بتاعك (6 أرقام) وكلمة السر الجديدة، وهننقل كوينزاتك وإطاراتك.</p>
  <input id="oldId" placeholder="الـ ID القديم - 6 أرقام" maxlength="6" inputmode="numeric">
  <button class="btn btn-purple" id="btnRestore">🔄 استرجع حسابي القديم</button></div>
  <p class="small center" style="margin-top:10px">التطبيق أونلاين بالكامل - لازم نت 📶<br>📱 التطبيق مخصص للأندرويد بس<br>🚌 من صنع <b>Hesham Etsh</b> © 2026</p></div>`;
}
function bindAuth(){
   const _ce=document.getElementById("btnCopyEmailAuth"); if(_ce) _ce.onclick=()=>{ try{ navigator.clipboard.writeText(EMAIL).then(()=>toast("البريد اتنسخ 📋")); }catch(e){ toast("البريد: "+EMAIL); } };
   const _gr=document.getElementById("btnGoRecover"); if(_gr) _gr.onclick=()=>{ recoverFound=null; view="recover"; render(); };
  const nameEl=document.getElementById("authName"), passEl=document.getElementById("authPass");

  // ===== من الأول: دوال نظيفة للدخول - مفيش ترقيع فوق ترقيع =====
  function cleanStr(s){ return String(s||"").replace(/[\u200e\u200f\u202a-\u202e\u2060\ufeff]/g,"").trim(); }
  function isOwnerInput(n){ const l=String(n||"").trim().toLowerCase(); return l==="860328" || l==="hisham" || l==="هشام" || l==="hisham etsh" || l.includes("hisham") || l.includes("هشام"); }
  function buildOwnerProfile(cloud, old){
    const base={id:HOST_ID, name:"Hisham", pass:OWNER_PASS, pic:"", emoji:"😎", frame:"", coins:999999, powers:{double:99,time:99,shield:99,hint:99}, ownedFrames:{}, ownedEmojis:{}, stats:{games:0,wins:0,totalScore:0,bestScore:0}, lastGift:"", createdAt:Date.now()};
    if(old){ base.pic=old.pic||base.pic; base.emoji=old.emoji||base.emoji; base.frame=old.frame||base.frame; base.powers=old.powers||base.powers; base.stats=old.stats||base.stats; }
    if(cloud){ base.pic=cloud.pic||base.pic; base.emoji=cloud.emoji||base.emoji; base.frame=cloud.frame||base.frame; base.stats=cloud.stats||base.stats; base.lastGift=cloud.lastGift||base.lastGift; }
    // v52: حساب المالك - كوينز كتير + كل الإطارات والإيموجي مفتوحة
    base.coins=999999;
    base.powers={double:99,time:99,shield:99,hint:99};
    try{ (typeof FRAMES!=="undefined"?FRAMES:[]).forEach(f=>{ base.ownedFrames[f.id]=true; }); }catch(e){}
    try{ (typeof EMOJIS!=="undefined"?EMOJIS:[]).forEach(e=>{ base.ownedEmojis[e.id]=true; }); }catch(e){}
    base.id=HOST_ID; base.name="Hisham"; base.pass=OWNER_PASS;
    return base;
  }
  // دخول المالك: يشتغل أوفلاين أولاً - يدخلك فوراً، وبعدين يزامن مع السيرفر في الخلفية من غير ما يعطّلك
  async function loginAsOwner(){
    toast("بيدخّل حساب المالك...");
    let cloud=null, old=null;
    try{ cloud=await fbGet("profiles/"+HOST_ID); }catch(e){}
    if(!cloud){
      try{ const r=await fetch(FB_OLD+"/autobus_profiles.json"); if(r.ok){ const j=await r.json(); if(j){ const arr=Array.isArray(j.profiles)?j.profiles:Object.values(j.profiles||j); old=arr.find(p=>p && String(p.id)===HOST_ID); } } }catch(e){}
    }
    const prof=buildOwnerProfile(cloud, old);
    me=prof; saveSession(); view="home"; render(); toast("✅ أهلاً يا مالك 👑");
    // زامن مع السيرفر في الخلفية - لو فشل مش مشكلة، انت دخلت خلاص
    try{ await fbPut("profiles/"+HOST_ID, prof); }catch(e){}
    try{ await afterLogin(); }catch(e){}
    return true;
  }

  // زرار العين 👁️ - إظهار / إخفاء كلمة السر
  const eyeBtn=document.getElementById("btnTogglePass");
  if(eyeBtn) eyeBtn.onclick=()=>{ try{ passEl.type = passEl.type==="password" ? "text" : "password"; eyeBtn.textContent = passEl.type==="password" ? "👁️" : "🙈"; }catch(e){} };

  document.getElementById("btnCreate").onclick=async ()=>{
    const name=cleanStr(nameEl.value), pass=cleanStr(passEl.value);
    if(name.length<2) return toast("اكتب اسمك الأول");
    if(pass.length<4) return toast("كلمة السر 4 حروف على الأقل");
    if(isOwnerInput(name)) return toast("ده اسم المالك - ادخل بحساب قديم");
    // v52: لو الحساب متسجل قبل كدا - امنع تكراره
    toast("بيتأكد إن الحساب مش متسجل...");
    if(/^\d{6}$/.test(name)){
      const exId=await fbGet("profiles/"+name);
      if(exId) return toast("⚠️ الحساب ده متسجل قبل كدا بالـ ID ده - ادخل بيه بدل ما تعمل حساب جديد");
    } else {
      const allDup=await fbGet("profiles");
      if(allDup){
        const nl=name.toLowerCase();
        const dup=Object.values(allDup).find(p=>p && p.name && p.name.trim().toLowerCase()===nl);
        if(dup) return toast("⚠️ الحساب ده متسجل قبل كدا باسم "+dup.name+" - ادخل بيه بدل ما تعمل حساب جديد (ID: "+dup.id+")");
      }
    }
    toast("بيعمل حسابك...");
    let id=null;
    for(let i=0;i<6;i++){ const cand=randId(); const ex=await fbGet("profiles/"+cand); if(!ex){ id=cand; break; } }
    if(!id) return toast("مش عارف يعمل حساب - حاول تاني");
    const profile={id, name, pass, pic:"", emoji:"😎", frame:"", coins:50, powers:{double:1,time:1,shield:0,hint:1}, ownedFrames:{}, ownedEmojis:{}, stats:{games:0,wins:0,totalScore:0,bestScore:0}, lastGift:"", createdAt:Date.now()};
    const ok=await fbPut("profiles/"+id, profile);
    if(!ok) return toast("مش عارف يوصل للسيرفر - اتأكد من النت 📶");
    me=profile; saveSession(); await afterLogin();
  };

  document.getElementById("btnLogin").onclick=async ()=>{
    const name=cleanStr(nameEl.value), pass=cleanStr(passEl.value);
    if(pass.length<4) return toast("اكتب كلمة السر");
    // المالك أولاً - قبل أي بحث في السيرفر
    if(isOwnerInput(name)){
      if(pass!==OWNER_PASS) return toast("كلمة سر المالك غلط - دوس 👁️ عشان تشوف اللي كتبته");
      await loginAsOwner(); return;
    }
    toast("بيدوّر على حسابك...");
    let profile=null;
    if(/^\d{6}$/.test(name)){ profile=await fbGet("profiles/"+name); }
    else {
      const all=await fbGet("profiles");
      if(all){
        const nl=name.toLowerCase();
        profile=Object.values(all).find(p=>p && p.name===name);
        if(!profile) profile=Object.values(all).find(p=>p && p.name && p.name.trim().toLowerCase()===nl);
      }
    }
    if(!profile) return toast("مفيش حساب بالاسم ده - اعمل حساب جديد أو جرّب الـ ID");
    if(profile.pass!==pass) return toast("كلمة السر غلط - دوس 👁️ عشان تشوف اللي كتبته");
    me=profile; saveSession(); await afterLogin();
  };

  document.getElementById("btnRestore").onclick=async ()=>{
    const oldId=cleanStr(document.getElementById("oldId").value), pass=cleanStr(passEl.value), name=cleanStr(nameEl.value);
    if(!/^\d{6}$/.test(oldId)) return toast("اكتب الـ ID القديم - 6 أرقام");
    if(pass.length<4) return toast("اكتب كلمة سر جديدة (4+)");
    toast("بينقل حسابك القديم...");
    let old=null;
    try{
      const r=await fetch(FB_OLD+"/autobus_profiles.json");
      if(r.ok){ const j=await r.json(); if(j){ const arr=Array.isArray(j.profiles)?j.profiles:Object.values(j.profiles||j); old=arr.find(p=>p && String(p.id)===oldId); } }
    }catch(e){}
    if(!old){
      try{ const r2=await fetch(FB_OLD+"/autobus_profiles/"+oldId+".json"); if(r2.ok) old=await r2.json(); }catch(e){}
    }
    if(!old) return toast("ملقيتش حساب قديم بالـ ID ده");
    const profile={id:oldId, name:name||old.name||"لاعب", pass, pic:old.pic||"", emoji:old.emoji||"😎", frame:old.frame||"", coins:old.coins||0, powers:old.powers||{double:1,time:1,shield:0,hint:1}, ownedFrames:old.ownedFrames||{}, ownedEmojis:old.ownedEmojis||{}, stats:old.stats||{games:0,wins:0,totalScore:0,bestScore:0}, lastGift:old.lastGift||"", createdAt:Date.now(), migrated:true};
    const ok=await fbPut("profiles/"+oldId, profile);
    if(!ok) return toast("مش عارف يوصل للسيرفر");
    me=profile; saveSession(); toast("✅ حسابك القديم اتنقل - "+(old.coins||0)+" كوينز"); await afterLogin();
  };
}
// كمّل أي حقل ناقص في البروفايل (حسابات قديمة) ورجّع اللي اتصلّح عشان يتحفظ في Firebase
// لو الملكية اتخزنت كمصفوفة بالغلط (مش كائن) - حوّلها لكائن ملكية سليم، عشان JSON.stringify بيضيّع مفاتيح المصفوفات
// وده كان سبب إن الإطارات/الإيموشنات مبتتحفظش: الملكية كانت بتتبعت كمصفوفة فاضية والسيرفر بيحفظها فاضية
function fixOwnedObj(v){
  if(!v || typeof v!=="object") return {};
  if(!Array.isArray(v)) return v;
  const o={};
  v.forEach(x=>{ if(typeof x==="string" && x) o[x]=true; });
  Object.keys(v).forEach(k=>{ if(isNaN(+k) && v[k]) o[k]=true; });
  return o;
}
function normalizeProfile(){
  if(!me) return {};
  const healed={};
  if(me.pic==null){ me.pic=""; healed.pic=""; }
  if(me.emoji==null){ me.emoji="😎"; healed.emoji="😎"; }
  if(me.frame==null){ me.frame=""; healed.frame=""; }
  if(me.coins==null){ me.coins=0; healed.coins=0; }
  if(!me.powers || typeof me.powers!=="object"){ me.powers={double:1,time:1,shield:0,hint:1}; healed.powers=me.powers; }
  const fixedFrames=fixOwnedObj(me.ownedFrames);
  if(fixedFrames!==me.ownedFrames){ me.ownedFrames=fixedFrames; healed.ownedFrames=fixedFrames; }
  const fixedEmojis=fixOwnedObj(me.ownedEmojis);
  if(fixedEmojis!==me.ownedEmojis){ me.ownedEmojis=fixedEmojis; healed.ownedEmojis=fixedEmojis; }
  if(!me.stats || typeof me.stats!=="object"){ me.stats={games:0,wins:0,totalScore:0,bestScore:0}; healed.stats=me.stats; }
  if(!me.creditedOrders || typeof me.creditedOrders!=="object"){ me.creditedOrders={}; healed.creditedOrders={}; }
  if(me.lastGift==null){ me.lastGift=""; healed.lastGift=""; }
  return healed;
}
async function afterLogin(){
  // حظر؟
  const ban=await fbGet("bans/"+me.id);
  if(ban && ban.until && ban.until>Date.now() && !isOwner()){
    myBan=ban; view="banned"; render(); return;
  }
  // إصلاح البروفايل: لو حساب قديم وناقصه حقول (صورة/مشتريات/قوى) كمّلها وارجع احفظها - عشان المشتريات والصورة متضيعش
  const healed=normalizeProfile();
  if(Object.keys(healed).length) await fbPatch("profiles/"+me.id, healed);
  // v46: الهدية اليومية بقت زرار يدوي في الرئيسية - مش أوتوماتيك عشان اللاعب يستلمها بنفسه
  view="home"; render();
  checkVersion();
}
async function checkVersion(){
  const v=await fbGet("version");
  if(v){ versionInfo=v; if(v.latestVersion && String(v.latestVersion).replace(/[^0-9]/g,"")*1 > CURRENT_VERSION.replace(/[^0-9]/g,"")*1){ if(view==="home") render(); } }
}

// ================= Home =================
function homeHTML(){
  // v46: هدية يومية يدوية +5 كوينز
  const giftDone = (me.lastGift||"")===todayStr();
  const giftLabel = giftDone ? "خدت هدية النهاردة ✅" : "🎁 هدية اليوم +5";
  const upd = versionInfo && versionInfo.latestVersion && String(versionInfo.latestVersion).replace(/[^0-9]/g,"")*1 > CURRENT_VERSION.replace(/[^0-9]/g,"")*1;
  const newUpd = broadcastsCache.filter(b=>b.time>updatesSeen).length;
  const myOrdersNew = ordersCache.filter(o=>o.userId===me.id && o.status==="done" && !(me.creditedOrders||{})[o.key]).length;
  return `<div class="hero"><h1>🚌 أتوبيس</h1><p class="sub">العب أونلاين مع صحابك • ${netOn?"متصل ✅ أونلاين":"بيتصل..."}</p><p class="small" style="color:#ffe8d5">📱 التطبيق مخصص للأندرويد بس • 🚌 من صنع Hesham Etsh</p>
  <div style="display:flex;gap:8px;justify-content:center;align-items:center;margin-top:8px">
    <span class="avatar-wrap ${me.frame?("frame-"+me.frame):""}" style="width:56px;height:56px;font-size:26px">${me.pic?`<img src="${me.pic}">`:"👤"}</span>
    <div style="text-align:right"><b style="font-size:18px">${esc(me.name)} ${isOwner()?"👑":""}</b><br><span style="font-size:12px">ID: ${me.id} • 🪙 ${me.coins} كوينز</span></div>
  </div>
  <div style="display:flex;gap:6px;justify-content:center;margin-top:10px">
    <button class="btn btn-green" id="btnPickPhoto" style="width:auto;margin:0;padding:8px 14px">📷 حط صورتك من موبايلك</button>
    ${me.pic?`<button class="btn btn-red" id="btnRemovePhoto" style="width:auto;margin:0;padding:8px 14px">🗑️ امسح صورتي</button>`:""}
    <input type="file" id="inpPhoto" accept="image/*" style="display:none">
  </div></div>
  ${upd?`<div class="card" style="background:#fff3cd;border:2px solid #ffc23d"><h3>🆕 في تحديث جديد ${esc(versionInfo.latestVersion)}</h3><p class="small">${esc(versionInfo.changelog||"")}</p><a class="btn btn-blue" href="${DOWNLOAD_URL}" target="_blank" rel="noopener">⬇️ حمّل التحديث</a></div>`:""}
  <div class="card"><h3>🎮 العب</h3>
  <div class="grid">
    <button class="btn btn-green" id="btnSolo">🤖 سولو (ضد وهميين)</button>
    <button class="btn btn-blue" id="btnCreateRoom">🏠 اعمل روم</button>
    <button class="btn btn-purple" id="btnLeague">🏆 الدوري</button>
    <button class="btn" id="btnJoinRoom">🚪 ادخل روم</button>
  </div>
  <div style="display:flex;gap:6px;margin-top:8px"><input id="inpRoomCode" placeholder="كود الروم - 4 حروف" maxlength="4" style="flex:1;margin:0;text-transform:uppercase"><button class="btn btn-green" id="btnJoinGo" style="width:110px;margin:0">ادخل ➡️</button></div>
  <p class="small center" style="margin-top:6px">ابعت كود الروم لصحابك يدخلوا معاك - أو ادخل بكود حد بعتوهولك</p></div>
  <div class="card"><h3>🛒 حسابك</h3><div class="grid">
    <button class="btn" id="btnShop">🛍️ المتجر</button>
    <button class="btn btn-green" id="btnCharge">🪙 اشحن كوينز</button>
    <button class="btn" id="btnOrders">📋 طلباتي ${myOrdersNew?`<span class="badge">${myOrdersNew} جاهز</span>`:""}</button>
    <button class="btn ${giftDone?"btn-white":"btn-green"}" id="btnGift" ${giftDone?"disabled":""}>${giftLabel}</button>
    ${isOwner()?`<button class="btn btn-purple" id="btnPlayersList">👥 قايمة اللاعبين 👑</button>`:""}
     <button class="btn btn-blue" id="btnUpdates">📢 تحديثات اللعبة ${newUpd?`<span class="badge" style="background:#e23b2e;color:#fff;min-width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:0 6px;font-size:13px;font-weight:900">${newUpd}</span>`:""}</button>
  </div>
  <p class="small center" style="margin-top:8px">⚡ قوى: ×2 (${(me.powers||{}).double||0}) • +15ث (${(me.powers||{}).time||0}) • 🛡️ (${(me.powers||{}).shield||0}) • 💡 (${(me.powers||{}).hint||0})</p></div>
  <div class="card"><h3>📊 إحصائياتك</h3><p class="small">🎮 جولات: ${(me.stats||{}).games||0} • 🏆 فوز: ${(me.stats||{}).wins||0} • ⭐ أفضل نتيجة: ${(me.stats||{}).bestScore||0} • 🔢 مجموع نقاطك: ${(me.stats||{}).totalScore||0}</p></div>
  ${isOwner()?`<div class="card" style="background:#f0eaff;border:2px solid #7c5cff"><h3>👑 لوحة المالك</h3><div class="grid">
    <button class="btn btn-purple" id="btnOwnerOrders">💰 طلبات الشحن ${ordersCache.filter(o=>o.status==="new").length?`<span class="badge">${ordersCache.filter(o=>o.status==="new").length} جديد</span>`:""}</button>
    <button class="btn btn-red" id="btnOwnerReports">🚨 البلاغات ${reportsCache.filter(r=>r.status==="new").length?`<span class="badge">${reportsCache.filter(r=>r.status==="new").length} جديد</span>`:""}</button>
    <button class="btn" id="btnOwnerPublish">📢 انشر تحديث</button>
    <button class="btn btn-green" id="btnOwnerGifts">🎁 منح هدايا</button>
     <button class="btn btn-purple" id="btnOwnerPlayers">👥 قايمة اللاعبين</button>
    <button class="btn" id="btnOwnerBans">🔨 حظر يدوي</button>
  </div></div>`:""}
  <div class="card"><h3>⚙️ إعدادات</h3><div class="grid">
    <button class="btn btn-white" id="btnSound">${soundOn?"🔊 الصوت شغال":"🔇 الصوت مقفول"}</button>
    <button class="btn btn-white" id="btnCopyId">📋 انسخ الـ ID</button>
    <button class="btn btn-white" id="btnReport">🚨 بلّغ عن لاعب</button>
    <button class="btn btn-red" id="btnLogout">🚪 خروج</button>
  </div></div>
  <div class="card" style="background:#eaf7ff;border:2px solid #0b5cff"><h3>📧 عندك مشكلة؟ كلّم المالك</h3>
  <p class="small">لو قابلتك أي مشكلة - شحن، روم، حساب - ابعتلي على الإيميل ده وهرد عليك:</p>
  <a href="mailto:${EMAIL}" style="display:block;text-align:center;background:#0b5cff;color:#fff;font-weight:900;border-radius:12px;padding:12px;margin-top:10px;text-decoration:none">📧 ${EMAIL}</a>
  <button class="btn btn-white" id="btnCopyEmail" style="margin-top:8px">📋 انسخ الإيميل</button></div>`;
}
async function handlePhotoPick(input){
  const file=input.files && input.files[0]; if(!file) return;
  input.value=""; // عشان يقدر يختار نفس الصورة تاني
  if(!file.type || !file.type.startsWith("image/")) return toast("اختار صورة مش ملف تاني 🖼️");
  try{
    const dataUrl=await new Promise((res,rej)=>{ const r=new FileReader(); r.onload=()=>res(r.result); r.onerror=()=>rej(new Error("read")); r.readAsDataURL(file); });
    const img=await new Promise((res,rej)=>{ const im=new Image(); im.onload=()=>res(im); im.onerror=()=>rej(new Error("img")); im.src=dataUrl; });
    const MAX=320; let w=img.naturalWidth||img.width, h=img.naturalHeight||img.height;
    const sc=Math.min(1, MAX/Math.max(w,h)); w=Math.max(1,Math.round(w*sc)); h=Math.max(1,Math.round(h*sc));
    const cv=document.createElement("canvas"); cv.width=w; cv.height=h;
    cv.getContext("2d").drawImage(img,0,0,w,h);
    const small=cv.toDataURL("image/jpeg",0.72);
    if(small.length>90000) return toast("الصورة كبيرة أوي - اختار صورة أصغر 📸");
    const oldPic=me.pic||"";
    me.pic=small;
    let okPic=await fbPatch("profiles/"+me.id, {pic:small});
    if(!okPic) okPic=await fbPatch("profiles/"+me.id, {pic:small}); // محاولة تانية لو النت قطع
    if(!okPic){ me.pic=oldPic; return toast("ماتحفظش - اتأكد من النت وحاول تاني 📶"); }
    toast("✅ صورتك اتحطت"); try{ playSound("win"); }catch(e){}
    render();
  }catch(e){ toast("مش عارف أقرا الصورة دي - جرّب صورة تانية 📸"); }
}
function bindHome(){
  const go=(v)=>{ view=v; render(); };
  const b=(id,fn)=>{ const e=document.getElementById(id); if(e) e.onclick=fn; };
  b("btnSolo", ()=>startSolo());
  b("btnCreateRoom", ()=>createRoom("classic"));
  b("btnLeague", ()=>createRoom("league"));
  b("btnJoinRoom", ()=>{ const c=document.getElementById("inpRoomCode").value.trim().toUpperCase(); if(!c) return toast("اكتب كود الروم"); joinRoom(c); });
  b("btnJoinGo", ()=>{ const c=document.getElementById("inpRoomCode").value.trim().toUpperCase(); if(!c) return toast("اكتب كود الروم"); joinRoom(c); });
  b("btnShop", ()=>go("shop")); b("btnCharge", ()=>go("charge")); b("btnOrders", ()=>go("orders")); b("btnUpdates", ()=>go("updates"));
  b("btnPlayersList", async ()=>{ const d=await fbGet("profiles"); const arr=objToArr(d).filter(p=>p && p.id && p.name); playersCache=arr.sort((a,b)=>String(a.name||"").localeCompare(String(b.name||""), "ar")); view="players"; render(); });
  // v46: زرار الهدية اليومية اليدوي +5
  b("btnGift", async ()=>{
    if((me.lastGift||"")===todayStr()) return toast("خدت هدية النهاردة خلاص ✅");
    const oldCoins=me.coins||0;
    me.coins=oldCoins+5; me.lastGift=todayStr();
    const okGift=await fbPatch("profiles/"+me.id, {coins:me.coins, lastGift:me.lastGift});
    if(!okGift){ me.coins=oldCoins; me.lastGift=""; return toast("ماتحفظش - اتأكد من النت 📶"); }
    toast("مبروك! خدت +5 كوينز 🪙🎉"); try{playSound("win");}catch(e){} render();
  });
  b("btnOwnerOrders", ()=>go("ownerOrders")); b("btnOwnerReports", ()=>go("ownerReports")); b("btnOwnerPublish", ()=>go("ownerPublish")); b("btnOwnerBans", ()=>go("ownerBans")); b("btnOwnerGifts", ()=>go("ownerGifts"));
  b("btnReport", ()=>go("report"));
  b("btnSound", ()=>{ soundOn=!soundOn; saveSound(); render(); });
  b("btnCopyId", ()=>{ try{ navigator.clipboard.writeText(me.id).then(()=>toast("الـ ID اتنسخ 📋")); }catch(e){ toast("الـ ID: "+me.id); } });
  b("btnCopyEmail", ()=>{ try{ navigator.clipboard.writeText(EMAIL).then(()=>toast("الإيميل اتنسخ 📋")); }catch(e){ toast("الإيميل: "+EMAIL); } });
  b("btnOwnerPlayers", async ()=>{ const d=await fbGet("profiles"); const arr=objToArr(d).filter(p=>p && p.id && p.name); playersCache=arr.sort((a,b)=>String(a.name||"").localeCompare(String(b.name||""), "ar")); view="players"; render(); });
  b("btnLogout", ()=>{ stopRoom(); me=null; saveSession(); view="auth"; render(); });
  // صورة البروفايل من معرض الموبايل
  b("btnPickPhoto", ()=>{ const f=document.getElementById("inpPhoto"); if(f) f.click(); });
  b("btnRemovePhoto", async ()=>{ const oldPic=me.pic||""; me.pic=""; const ok=await fbPatch("profiles/"+me.id, {pic:""}); if(!ok){ me.pic=oldPic; return toast("ماتمسحش - اتأكد من النت وحاول تاني 📶"); } toast("✅ صورتك اتمسحت - رجعت للإيموجي"); render(); });
  const inpPh=document.getElementById("inpPhoto"); if(inpPh) inpPh.onchange=()=>handlePhotoPick(inpPh);
  // حدّث الطلبات والتحديثات في الخلفية عشان العدادات - ارسم بس لو فعلاً في جديد (عشان متعملش حلقة رسم)
  fbGet("orders").then(d=>{ const a=objToArr(d); if(JSON.stringify(a)!==JSON.stringify(ordersCache)){ ordersCache=a; if(view==="home") render(); } }).catch(()=>{});
  fbGet("broadcasts").then(d=>{ const a=objToArr(d); if(JSON.stringify(a)!==JSON.stringify(broadcastsCache)){ broadcastsCache=a; if(view==="home") render(); } }).catch(()=>{});
  if(isOwner()){ fbGet("reports").then(d=>{ const a=objToArr(d); if(JSON.stringify(a)!==JSON.stringify(reportsCache)){ reportsCache=a; if(view==="home") render(); } }).catch(()=>{}); }
}
function objToArr(o){ if(!o) return []; return Object.entries(o).map(([k,v])=>({...v, key:k})); }

// ================= Shop =================
// احفظ الشراء - صدّق نتيجة الـ PATCH (لو السيرفر رد 200 يبقى اتحفظ فعلًا) وحاول 3 مرات قبل ما تستسلم
// ملحوظة: مبنعملش قراءة تأكيد بعد الحفظ، لأن القراءة ممكن تفشل بسبب النت حتى لو الحفظ نجح، وده كان بيدي "ماتحفظش" كدب
async function patchAndConfirm(patchData){
  for(let i=0;i<3;i++){
    const ok=await fbPatch("profiles/"+me.id, patchData);
    if(ok) return {ok:true};
    if(i<2) await new Promise(r=>setTimeout(r, 700));
  }
  return {ok:false, err:lastFbError||"فشل الاتصال"};
}
function shopHTML(){
  return `<div class="card"><h2>🛍️ المتجر</h2><p class="small">🪙 رصيدك: <b>${me.coins}</b> كوينز</p>
  <div class="grid"><button class="btn ${shopTab==="powers"?"btn-blue":"btn-white"}" id="tabPowers">⚡ قوى</button><button class="btn ${shopTab==="frames"?"btn-blue":"btn-white"}" id="tabFrames">🖼️ إطارات</button><button class="btn ${shopTab==="emojis"?"btn-blue":"btn-white"}" id="tabEmojis">😎 إيموجي</button></div>
  ${shopTab==="powers"?POWERS.map(pw=>`<div class="shop-item"><div><b>${pw.icon} ${pw.name}</b><br><small>${pw.desc} • عندك: ${(me.powers||{})[pw.id]||0}</small></div><button class="btn btn-green" style="width:auto;margin:0;padding:9px 14px" data-buy-power="${pw.id}">🪙 ${pw.price}</button></div>`).join(""):""}
  ${shopTab==="frames"?`<p class="small center">🤗 الحيوان <b>حاضن صورتك</b> من المعرض - تنين 🐉، باندا 🐼، نمر 🐯... حط صورتك الأول عشان الحيوان يحضنها.</p>`+FRAMES.map(f=>{ const owned=(me.ownedFrames||{})[f.id]; const equipped=me.frame===f.id; return `<div class="shop-item"><div style="display:flex;gap:8px;align-items:center"><span class="avatar-wrap frame-${f.id}" style="width:48px;height:48px;font-size:22px">${me.pic?`<img src="${me.pic}">`:"👤"}</span><div><b>${f.name}</b><br><small>${owned?"✅ عندك":("🪙 "+f.price+" كوينز")} ${equipped?"• لابسه دلوقتي":""} • إطار لصورتك 📷</small></div></div><button class="btn ${owned?"btn-blue":"btn-green"}" style="width:auto;margin:0;padding:9px 14px" data-frame="${f.id}">${owned?(equipped?"لابسه ✅":"البس"):("🪙 "+f.price)}</button></div>`; }).join(""):""} 
  ${shopTab==="emojis"?`<p class="small center">💬 ملصقات <b>تعبيرية لشات الروم فقط</b> - ملصق كبير 😂 😍 🔥 للتعبير في الشات، مش صورة بروفايل.</p>`+EMOJIS.map(e=>{ const owned=(me.ownedEmojis||{})[e.id]; return `<div class="shop-item"><div><b>${e.emoji} ${e.name}</b><br><small>${owned?"✅ عندك - هتلاقيه في شات الروم":("🪙 "+e.price+" كوينز")} • لشات الروم فقط 💬</small></div><button class="btn ${owned?"btn-blue":"btn-green"}" style="width:auto;margin:0;padding:9px 14px" data-emoji="${e.id}">${owned?"عندك ✅":("🪙 "+e.price)}</button></div>`; }).join(""):""} 
  </div><button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindShop(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  const t=(id,tab)=>{ const e=document.getElementById(id); if(e) e.onclick=()=>{ shopTab=tab; render(); }; };
  t("tabPowers","powers"); t("tabFrames","frames"); t("tabEmojis","emojis");
  document.querySelectorAll("[data-buy-power]").forEach(b=>b.onclick=async ()=>{
    const pw=POWERS.find(x=>x.id===b.dataset.buyPower); if(!pw) return;
    if((me.coins||0)<pw.price) return toast("كوينزاتك مش كفاية - اشحن من الشحن 🪙");
    me.powers=me.powers||{};
    const oldCoins=me.coins;
    me.coins-=pw.price; me.powers[pw.id]=(me.powers[pw.id]||0)+1;
    const resPw=await patchAndConfirm({coins:me.coins, powers:me.powers});
    if(!resPw.ok){ me.coins=oldCoins; me.powers[pw.id]--; return toast("ماتحفظش - السبب: "+(resPw.err||"اتأكد من النت 📶")); }
    toast("✅ اشتريت "+pw.name+" - اتحفظ في حسابك"); playSound("win"); render();
  });
  document.querySelectorAll("[data-frame]").forEach(b=>b.onclick=async ()=>{
    const f=FRAMES.find(x=>x.id===b.dataset.frame); if(!f) return;
    me.ownedFrames=fixOwnedObj(me.ownedFrames);
    if(!me.ownedFrames[f.id]){
      if((me.coins||0)<f.price) return toast("كوينزاتك مش كفاية");
      const oldCoins=me.coins, oldFrame=me.frame;
      me.coins-=f.price; me.ownedFrames[f.id]=true; me.frame=f.id;
      const res=await patchAndConfirm({coins:me.coins, ownedFrames:me.ownedFrames, frame:f.id});
      if(!res.ok){ me.coins=oldCoins; delete me.ownedFrames[f.id]; me.frame=oldFrame; return toast("ماتحفظش - السبب: "+(res.err||"اتأكد من النت 📶")); }
      toast("✅ اشتريت "+f.name+" - اتحفظ في حسابك");
    } else {
      me.frame=f.id;
      const ok2=await fbPatch("profiles/"+me.id, {frame:f.id});
      if(!ok2) return toast("ماتحفظش - اتأكد من النت 📶");
    }
    render();
  });
  document.querySelectorAll("[data-emoji]").forEach(b=>b.onclick=async ()=>{
    const e=EMOJIS.find(x=>x.id===b.dataset.emoji); if(!e) return;
    me.ownedEmojis=fixOwnedObj(me.ownedEmojis);
    if(!me.ownedEmojis[e.id]){
      if((me.coins||0)<e.price) return toast("كوينزاتك مش كفاية");
      const oldCoins=me.coins;
      me.coins-=e.price; me.ownedEmojis[e.id]=true;
      // v52: الإيموجي لشات الروم فقط - مش بيغير صورتك ولا بيمسحها
      const res=await patchAndConfirm({coins:me.coins, ownedEmojis:me.ownedEmojis});
      if(!res.ok){ me.coins=oldCoins; delete me.ownedEmojis[e.id]; return toast("ماتحفظش - السبب: "+(res.err||"اتأكد من النت 📶")); }
      toast("✅ اشتريت "+e.name+" - هتلاقيه في شات الروم 💬");
    } else {
      toast("عندك already - هتلاقيه في شات الروم 💬");
    }
    render();
  });
}

// ================= Charge + Orders =================
function chargeHTML(){
  return `<div class="card"><h2>🪙 اشحن كوينز</h2><p class="small">اختار باقة، اكتب رقم المحفظة، والمالك هيأكد طلبك والكوينزات هتوصلك أوتوماتيك.</p>
  <div style="background:#e8f8ec;border:2px solid #1faa59;border-radius:14px;padding:12px;margin-bottom:12px;text-align:center">
  <div class="small">📱 ابعت الفلوس الأول على الرقم ده:</div>
  <div style="font-size:26px;font-weight:900;letter-spacing:2px;direction:ltr">${VODAFONE}</div>
  <div class="small">فودافون كاش - باسم المالك</div>
  <button class="btn btn-green" id="btnCopyVodafone" style="margin:8px 0 0">📋 انسخ الرقم</button>
  <p class="small" style="margin:8px 0 0">بعد ما تبعت، اختار الباقة تحت واكتب <b>رقم المحفظة اللي بعت منها</b> عشان المالك يتأكد.</p></div>
  ${PACKAGES.map((pk,i)=>`<div class="shop-item"><div><b>🪙 ${pk.coins} كوينز</b><br><small>${pk.price} جنيه ${pk.tag}</small></div><button class="btn btn-green" style="width:auto;margin:0;padding:9px 14px" data-pkg="${i}">اختار</button></div>`).join("")}
  <div id="chargeForm" style="display:none;background:#f7ecdc;border-radius:14px;padding:12px;margin-top:12px">
  <b id="chargePick"></b><label>💳 طريقة الدفع</label>
  <select id="payMethod"><option>فودافون كاش</option><option>انستا باي</option><option>أورانج كاش</option></select>
  <label>📱 رقم المحفظة اللي بعت منها</label><input id="payPhone" placeholder="01xxxxxxxxx" maxlength="11" inputmode="numeric">
  <button class="btn btn-green" id="btnSendOrder">✅ ابعت الطلب</button></div></div>
  <button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindCharge(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  const cv=document.getElementById("btnCopyVodafone"); if(cv) cv.onclick=()=>{ try{ navigator.clipboard.writeText(VODAFONE).then(()=>toast("الرقم اتنسخ 📋")); }catch(e){ toast("الرقم: "+VODAFONE); } };
  let picked=0;
  document.querySelectorAll("[data-pkg]").forEach(b=>b.onclick=()=>{
    picked=+b.dataset.pkg;
    document.getElementById("chargeForm").style.display="block";
    document.getElementById("chargePick").textContent="باقة: 🪙 "+PACKAGES[picked].coins+" كوينز = "+PACKAGES[picked].price+" جنيه";
  });
  document.getElementById("btnSendOrder").onclick=async ()=>{
    const phone=document.getElementById("payPhone").value.trim();
    const method=document.getElementById("payMethod").value;
    if(!/^01\d{9}$/.test(phone)) return toast("اكتب رقم محفظة صح - 11 رقم يبدأ بـ 01");
    const pk=PACKAGES[picked];
    const key=await fbPost("orders", {userId:me.id, userName:me.name, type:"coins", coins:pk.coins, price:pk.price, method, phone, status:"new", time:Date.now()});
    if(!key) return toast("مش عارف يبعت الطلب - اتأكد من النت 📶");
    toast("✅ طلبك اتسجل - المالك هيأكده والكوينزات هتوصلك"); playSound("win"); view="orders"; render();
  };
}
function ordersHTML(){
  const mine=ordersCache.filter(o=>o.userId===me.id).sort((a,b)=>b.time-a.time);
  return `<div class="card"><h2>📋 طلباتي</h2><p class="small">لما المالك يأكد طلبك، دوس "استلم" والكوينزات هتتضاف لحسابك.</p>
  ${mine.length?mine.map(o=>{
    const credited=(me.creditedOrders||{})[o.key];
    const st=o.status==="new"?"⏳ مستني تأكيد المالك":o.status==="done"?(credited?"✅ استلمت":"🎉 اتأكد! دوس استلم"):o.status==="rejected"?"❌ اترفض":"";
    return `<div class="shop-item"><div><b>🪙 ${o.coins} كوينز - ${o.price} جنيه</b><br><small>${o.method} • ${esc(o.phone||"")} • ${fmtTime(o.time)}</small><br><small>${st}</small></div>
    ${o.status==="done"&&!credited?`<button class="btn btn-green" style="width:auto;margin:0;padding:9px 14px" data-claim="${o.key}">استلم 🎁</button>`:""}</div>`;
  }).join(""):'<p class="small" style="margin-top:8px">لسه معملتش طلبات - روح الشحن واختار باقة</p>'}
  </div><button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindOrders(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  fbGet("orders").then(d=>{ const a=objToArr(d); if(JSON.stringify(a)!==JSON.stringify(ordersCache)){ ordersCache=a; if(view==="orders") render(); } }).catch(()=>{});
  document.querySelectorAll("[data-claim]").forEach(b=>b.onclick=async ()=>{
    const key=b.dataset.claim;
    const o=ordersCache.find(x=>x.key===key); if(!o) return;
    if((me.creditedOrders||{})[key]) return toast("استلمته قبل كده");
    me.coins=(me.coins||0)+o.coins; me.creditedOrders=me.creditedOrders||{}; me.creditedOrders[key]=true;
    await fbPatch("profiles/"+me.id, {coins:me.coins, creditedOrders:me.creditedOrders});
    toast("🎉 +"+o.coins+" كوينز اتضافوا لحسابك"); playSound("win"); render();
  });
}

// ================= Updates =================
function updatesHTML(){
  const list=broadcastsCache.slice().sort((a,b)=>b.time-a.time);
  return `<div class="card"><h2>📢 تحديثات اللعبة</h2>
  <p class="small">${isOwner()?"انت المالك - اكتب التحديث هنا وهيوصل لكل اللاعبين.":"المالك بس اللي بيبعت هنا - لو عندك مشكلة ابعتله على الإيميل اللي تحت في الرئيسية 📧"}</p>
  ${isOwner()?`<input id="updInp" placeholder="اكتب التحديث... ممكن تحط لينك هنا" maxlength="500"><button class="btn btn-purple" id="btnSendUpd">📢 ابعت للكل</button>`:""}
  <div style="margin-top:12px"><b>📢 آخر التحديثات (${list.length})</b>
  ${list.length?list.map(b=>`<div style="background:#fff3cd;border:2px solid #ffc23d;border-radius:12px;padding:10px;margin-top:8px"><b>👑 المالك:</b> <span style="word-break:break-word">${linkify(b.text)}</span><div class="small">${fmtTime(b.time)}</div></div>`).join(""):'<p class="small" style="margin-top:8px">لسه مفيش تحديثات - أول ما المالك يبعت هتظهر هنا</p>'}
  </div></div><button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindUpdates(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  // علّم إنك شوفت التحديثات
  try{ localStorage.setItem("autobus_updates_seen_v2", String(Date.now())); updatesSeen=Date.now(); }catch(e){}
  const sendBtn=document.getElementById("btnSendUpd");
  if(sendBtn) sendBtn.onclick=async ()=>{
    const inp=document.getElementById("updInp"); const txt=inp.value.trim(); if(!txt) return toast("اكتب التحديث الأول");
    const key=await fbPost("broadcasts", {text:txt, time:Date.now(), fromName:me.name});
    if(!key) return toast("مش عارف ابعت - اتأكد من النت 📶");
    inp.value=""; toast("✅ اتبعت لكل اللاعبين 📢"); 
  };
}

// ================= Report (user) =================
function reportHTML(){
  return `<div class="card"><h2>🚨 بلّغ عن لاعب</h2><p class="small">لو حد بيغش أو بيقل أدبه، بلّغ عنه والمالك هيراجع ويحظره لو لازم.</p>
  <label>🆔 ID اللاعب اللي هتبلغ عنه</label><input id="repTarget" placeholder="6 أرقام" maxlength="6" inputmode="numeric">
  <label>📝 السبب</label><input id="repReason" placeholder="بيغش / بيقل أدبه / ..." maxlength="200">
  <button class="btn btn-red" id="btnSendRep">🚨 ابعت البلاغ</button></div>
  <button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindReport(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  document.getElementById("btnSendRep").onclick=async ()=>{
    const tid=document.getElementById("repTarget").value.trim(), reason=document.getElementById("repReason").value.trim();
    if(!/^\d{6}$/.test(tid)) return toast("اكتب ID صح - 6 أرقام");
    if(reason.length<3) return toast("اكتب السبب");
    if(tid===me.id) return toast("مينفعش تبلغ عن نفسك 😅");
    const key=await fbPost("reports", {fromId:me.id, fromName:me.name, targetId:tid, targetName:"", reason, status:"new", time:Date.now()});
    if(!key) return toast("مش عارف يبعت - اتأكد من النت 📶");
    toast("✅ البلاغ اتبعت للمالك"); view="home"; render();
  };
}

// ================= Owner panels =================
function ownerOrdersHTML(){
  const list=ordersCache.slice().sort((a,b)=>b.time-a.time);
  const news=list.filter(o=>o.status==="new");
  return `<div class="card"><h2>💰 طلبات الشحن 👑</h2><p class="small">أكّد الطلب بعد ما تتأكد إن الفلوس وصلت - الكوينزات هتوصل للاعب أوتوماتيك لما يدوس "استلم".</p>
  ${news.length?news.map(o=>`<div class="shop-item"><div><b>${esc(o.userName)} (ID: ${o.userId})</b><br><small>🪙 ${o.coins} كوينز • ${o.price} جنيه • ${o.method} • ${esc(o.phone||"")} • ${fmtTime(o.time)}</small></div>
  <div style="display:flex;gap:4px"><button class="btn btn-green" style="width:auto;margin:0;padding:8px 10px" data-ok="${o.key}">أكّد ✅</button><button class="btn btn-red" style="width:auto;margin:0;padding:8px 10px" data-no="${o.key}">ارفض ❌</button></div></div>`).join(""):'<p class="small" style="margin-top:8px">مفيش طلبات جديدة 🎉</p>'}
  <h3 style="margin-top:14px">📜 آخر الطلبات</h3>
  ${list.slice(0,15).map(o=>`<div class="small" style="padding:6px 0;border-bottom:1px solid #f0e0c8">${esc(o.userName)} • 🪙 ${o.coins} • ${o.status==="new"?"⏳ جديد":o.status==="done"?"✅ اتأكد":"❌ اترفض"} • ${fmtTime(o.time)}</div>`).join("")}
  </div><button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindOwnerOrders(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  document.querySelectorAll("[data-ok]").forEach(b=>b.onclick=async ()=>{ await fbPatch("orders/"+b.dataset.ok, {status:"done"}); toast("✅ اتأكد - الكوينزات هتوصل للاعب"); loadOwnerData(); });
  document.querySelectorAll("[data-no]").forEach(b=>b.onclick=async ()=>{ await fbPatch("orders/"+b.dataset.no, {status:"rejected"}); toast("❌ اترفض"); loadOwnerData(); });
}
async function loadOwnerData(){
  const [o, r] = await Promise.all([fbGet("orders"), fbGet("reports")]);
  ordersCache=objToArr(o); reportsCache=objToArr(r);
  if(view==="ownerOrders"||view==="ownerReports"||view==="home") render();
}
function ownerReportsHTML(){
  const list=reportsCache.slice().sort((a,b)=>b.time-a.time);
  const news=list.filter(r=>r.status==="new");
  return `<div class="card"><h2>🚨 البلاغات 👑</h2>
  ${news.length?news.map(r=>`<div class="shop-item" style="display:block"><div><b>${esc(r.fromName)} (ID: ${r.fromId}) بلّغ عن ID: ${r.targetId}</b><br><small>السبب: ${esc(r.reason)}</small><br><small>${fmtTime(r.time)}</small></div>
  <div style="display:flex;gap:4px;flex-wrap:wrap;margin-top:6px">
  <button class="btn btn-red" style="width:auto;margin:0;padding:8px 10px" data-ban="${r.targetId}|86400000">حظر يوم</button>
  <button class="btn btn-red" style="width:auto;margin:0;padding:8px 10px" data-ban="${r.targetId}|604800000">حظر أسبوع</button>
  <button class="btn btn-red" style="width:auto;margin:0;padding:8px 10px" data-ban="${r.targetId}|2592000000">حظر شهر</button>
  <button class="btn btn-red" style="width:auto;margin:0;padding:8px 10px" data-ban="${r.targetId}|315360000000">حظر نهائي</button>
  <button class="btn btn-white" style="width:auto;margin:0;padding:8px 10px" data-dismiss="${r.key}">تجاهل</button></div></div>`).join(""):'<p class="small" style="margin-top:8px">مفيش بلاغات جديدة 🎉</p>'}
  </div><button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindOwnerReports(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  document.querySelectorAll("[data-ban]").forEach(b=>b.onclick=async ()=>{
    const [tid, dur]=b.dataset.ban.split("|");
    await fbPatch("bans/"+tid, {until:Date.now()+ +dur, reason:"بلاغ", by:me.id});
    // اقفل كل البلاغات المفتوحة على نفس اللاعب
    for(const r of reportsCache.filter(x=>x.targetId===tid && x.status==="new")) await fbPatch("reports/"+r.key, {status:"done"});
    toast("🔨 اتحظر"); loadOwnerData();
  });
  document.querySelectorAll("[data-dismiss]").forEach(b=>b.onclick=async ()=>{ await fbPatch("reports/"+b.dataset.dismiss, {status:"done"}); toast("اتجاهل"); loadOwnerData(); });
}
function ownerPublishHTML(){
  return `<div class="card"><h2>📢 انشر تحديث 👑</h2><p class="small">لما تنشر نسخة جديدة، كل اللاعبين هيشوفوا بنر التحديث في الرئيسية.</p>
  <label>رقم النسخة</label><input id="pubVer" placeholder="مثال: v46" maxlength="10">
  <label>ايه الجديد؟</label><input id="pubChange" placeholder="صلحنا الرومات - بقت أسرع" maxlength="200">
  <button class="btn btn-purple" id="btnPub">📢 انشر</button>
  <p class="small" style="margin-top:8px">لينك التحميل الحالي: ${DOWNLOAD_URL}</p></div>
  <button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindOwnerPublish(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  document.getElementById("btnPub").onclick=async ()=>{
    const v=document.getElementById("pubVer").value.trim(), ch=document.getElementById("pubChange").value.trim();
    if(!v) return toast("اكتب رقم النسخة");
    await fbPut("version", {latestVersion:v, changelog:ch, time:Date.now()});
    versionInfo={latestVersion:v, changelog:ch};
    // v46: انشر كمان في التحديثات عشان يظهر رقم على زرار التحديثات لكل المستخدمين
    try{ await fbPost("broadcasts", {text:"🆕 تحديث جديد "+v+" - "+(ch||"نسخة جديدة"), time:Date.now(), fromName:me.name}); }catch(e){}
    toast("✅ اتنشر - اللاعبين هيشوفوا رقم على زرار التحديثات"); view="home"; render();
  };
}
function ownerBansHTML(){
  return `<div class="card"><h2>🔨 حظر يدوي 👑</h2>
  <label>🆔 ID اللاعب</label><input id="banId" placeholder="6 أرقام" maxlength="6" inputmode="numeric">
  <label>المدة</label><select id="banDur"><option value="86400000">يوم</option><option value="604800000">أسبوع</option><option value="2592000000">شهر</option><option value="315360000000">نهائي</option></select>
  <label>السبب</label><input id="banReason" placeholder="السبب..." maxlength="200">
  <button class="btn btn-red" id="btnDoBan">🔨 احظر</button>
  <button class="btn btn-white" id="btnUnban" style="margin-top:8px">✅ فك الحظر عن الـ ID ده</button></div>
  <button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindOwnerBans(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  document.getElementById("btnDoBan").onclick=async ()=>{
    const id=document.getElementById("banId").value.trim(), dur=+document.getElementById("banDur").value, reason=document.getElementById("banReason").value.trim()||"حظر من المالك";
    if(!/^\d{6}$/.test(id)) return toast("اكتب ID صح");
    await fbPatch("bans/"+id, {until:Date.now()+dur, reason});
    toast("🔨 اتحظر");
  };
  document.getElementById("btnUnban").onclick=async ()=>{
    const id=document.getElementById("banId").value.trim();
    if(!/^\d{6}$/.test(id)) return toast("اكتب ID صح");
    await fbDel("bans/"+id); toast("✅ اتفك الحظر");
  };
}

// ================= v46: منح هدايا من المالك =================
function ownerGiftsHTML(){
  return `<div class="card"><h2>🎁 منح هدايا 👑</h2><p class="small">امنح كوينز أو إطارات لأي مستخدم عن طريق الـ ID بتاعه.</p>
  <label>🆔 ID اللاعب</label><input id="giftUserId" placeholder="6 أرقام" maxlength="6" inputmode="numeric">
  <label>نوع الهدية</label><select id="giftType"><option value="coins">🪙 كوينز</option><option value="frame">🖼️ إطار</option></select>
  <div id="giftCoinsBox"><label>عدد الكوينز</label><input id="giftCoins" type="number" placeholder="مثال: 100" value="100"><div style="display:flex;gap:6px;margin-top:6px"><button class="btn btn-white" style="width:auto;margin:0;padding:8px 12px" data-gift-amt="20">20</button><button class="btn btn-white" style="width:auto;margin:0;padding:8px 12px" data-gift-amt="50">50</button><button class="btn btn-white" style="width:auto;margin:0;padding:8px 12px" data-gift-amt="100">100</button><button class="btn btn-white" style="width:auto;margin:0;padding:8px 12px" data-gift-amt="500">500</button></div></div>
  <div id="giftFrameBox" style="display:none"><label>اختار الإطار</label><select id="giftFrame">${FRAMES.map(f=>`<option value="${f.id}">${f.emoji} ${f.name}</option>`).join("")}</select></div>
  <button class="btn btn-green" id="btnDoGift">🎁 ابعت الهدية</button><p class="small" id="giftResult" style="margin-top:8px"></p></div>
  <button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindOwnerGifts(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  const typeSel=document.getElementById("giftType");
  const coinsBox=document.getElementById("giftCoinsBox");
  const frameBox=document.getElementById("giftFrameBox");
  if(typeSel) typeSel.onchange=()=>{ const isFrame=typeSel.value==="frame"; if(coinsBox) coinsBox.style.display=isFrame?"none":"block"; if(frameBox) frameBox.style.display=isFrame?"block":"none"; };
  document.querySelectorAll("[data-gift-amt]").forEach(b=>b.onclick=()=>{ const inp=document.getElementById("giftCoins"); if(inp) inp.value=b.dataset.giftAmt; });
  document.getElementById("btnDoGift").onclick=async ()=>{
    const id=(document.getElementById("giftUserId").value||"").trim();
    const type=(document.getElementById("giftType").value||"coins");
    if(!/^\d{6}$/.test(id)) return toast("اكتب ID صح - 6 أرقام");
    const prof=await fbGet("profiles/"+id);
    if(!prof) return toast("مفيش حساب بالـ ID ده");
    if(type==="coins"){
      const amt=parseInt(document.getElementById("giftCoins").value||"0")||0;
      if(!amt || amt<=0) return toast("اكتب عدد كوينز صح");
      const newCoins=(prof.coins||0)+amt;
      const ok=await fbPatch("profiles/"+id, {coins:newCoins});
      if(!ok) return toast("ماتحفظش - اتأكد من النت 📶");
      if(id===me.id) me.coins=newCoins;
      toast("✅ اتبعت "+amt+" كوينز لـ "+(prof.name||id)+" 🎁");
      try{ await fbPost("gifts", {toId:id, toName:prof.name||"", type:"coins", amount:amt, from:me.id, time:Date.now()}); }catch(e){}
    } else {
      const frameId=document.getElementById("giftFrame").value;
      const f=FRAMES.find(x=>x.id===frameId); if(!f) return toast("اختار إطار");
      const owned={...(prof.ownedFrames||{})}; owned[f.id]=true;
      const ok=await fbPatch("profiles/"+id, {ownedFrames:owned});
      if(!ok) return toast("ماتحفظش - اتأكد من النت 📶");
      if(id===me.id) me.ownedFrames=owned;
      toast("✅ اتبعت إطار "+f.name+" لـ "+(prof.name||id)+" 🖼️");
      try{ await fbPost("gifts", {toId:id, toName:prof.name||"", type:"frame", amount:frameId, from:me.id, time:Date.now()}); }catch(e){}
    }
    const res=document.getElementById("giftResult"); if(res) res.textContent="تم ✅";
  };
}

// ================= Rooms =================
function playerObj(){ return {id:me.id, name:me.name, pic:me.pic||"", emoji:me.emoji||"😎", frame:me.frame||"", score:0, joinedAt:Date.now(), lastSeen:Date.now()}; }
function roomPlayersArr(){ return roomData && roomData.players ? Object.values(roomData.players).sort((a,b)=>a.joinedAt-b.joinedAt) : []; }
function amHost(){ return roomData && roomData.hostId===me.id; }
function myPlayer(){ return roomData && roomData.players ? roomData.players[me.id] : null; }
async function createRoom(mode){
  if(myBan) return toast("🔴 حسابك محظور");
  const code=randCode();
  const room={code, hostId:me.id, hostName:me.name, createdAt:Date.now(), state:"lobby", mode:mode||"classic", letter:"", secs:60, startedAt:0, answers:{}, review:null, scores:{}, usedLetters:[], players:{[me.id]:playerObj()}, chat:{}};
  const ok=await fbPut("rooms/"+code, room);
  if(!ok) return toast("مش عارف يعمل روم - اتأكد من النت 📶");
  joinRoom(code);
}
async function joinRoom(code){
  if(myBan) return toast("🔴 حسابك محظور");
  code=String(code||"").trim().toUpperCase();
  if(!code) return;
  toast("بيدخل الروم...");
  const room=await fbGet("rooms/"+code);
  if(!room) return toast("مفيش روم بالكود ده - اتأكد من الكود");
  const players=room.players||{};
  if(!players[me.id] && Object.keys(players).length>=10) return toast("الروم مليان (10 لاعبين)");
  if(!players[me.id]){
    await fbPatch("rooms/"+code+"/players/"+me.id, playerObj());
    await fbPost("rooms/"+code+"/chat", {name:"أتوبيس 🚌", text:me.name+" دخل الروم 🎉", time:Date.now()});
  }
  roomCode=code; roomData=room; view="room"; render();
  startRoomStream(); startHeartbeat();
}
function startHeartbeat(){
  stopHeartbeat();
  heartInt=setInterval(async ()=>{
    if(!roomCode || !me) return;
    await fbPatch("rooms/"+roomCode+"/players/"+me.id, {lastSeen:Date.now()});
    // الهوست بيمسح اللي خرجوا من غير ما يدوسوا خروج
    if(amHost() && roomData && roomData.players){
      const now=Date.now();
      for(const p of Object.values(roomData.players)){
        if(p.id!==me.id && now-(p.lastSeen||0)>25000){ await fbDel("rooms/"+roomCode+"/players/"+p.id); }
      }
    }
  }, 5000);
}
function stopHeartbeat(){ if(heartInt){ clearInterval(heartInt); heartInt=null; } }
// بصمة الروم من غير lastSeen - عشان تحديث نبض الحضور كل 5 ثواني ميرسمش الشاشة من جديد ويقفل الكيبورد
function roomSig(r){
  if(!r) return "";
  try{
    const c=JSON.parse(JSON.stringify(r));
    if(c.players) Object.values(c.players).forEach(p=>{ delete p.lastSeen; });
    delete c.lastSeen;
    return JSON.stringify(c);
  }catch(e){ return JSON.stringify(r); }
}
let prevRoomSig="";
function startRoomStream(){
  if(roomStop) roomStop();
  prevRoomSig="";
  roomStop=fbStream("rooms/"+roomCode, async ()=>{
    if(!roomCode) return;
    const room=await fbGet("rooms/"+roomCode);
    if(!room){
      toast("الروم اتقفل"); stopRoom(); view="home"; render(); return;
    }
    const prevState=roomData?roomData.state:null;
    const prevChatCount=roomData&&roomData.chat?Object.keys(roomData.chat).length:0;
    roomData=room;
    // لو اللي اتغير هو lastSeen بس (نبض الحضور كل 5 ثواني) - متعملش حاجة خالص عشان الكيبورد ميتقفلش
    const sig=roomSig(room);
    if(sig===prevRoomSig && (view==="room" || view==="game" || view==="result")) return;
    prevRoomSig=sig;
    // نقل القيادة: لو الهوست خرج، أقدم لاعب يبقى هوست
    const players=roomPlayersArr();
    if(players.length && !room.players[room.hostId]){
      const earliest=players[0];
      if(earliest.id===me.id) await fbPatch("rooms/"+roomCode, {hostId:me.id, hostName:me.name});
    }
    if(view==="room" || view==="game" || view==="result"){
      const chatCount=room.chat?Object.keys(room.chat).length:0;
      const savedChat=view==="room" ? (document.getElementById("roomChatInp")?document.getElementById("roomChatInp").value:"") : "";
      if(view==="game" && room.state==="playing" && prevState==="playing"){
        // وانت بتكتب في الجولة: حدّث قايمة اللي سلّموا بس - مترسمش الصفحة كلها عشان الكتابة متقطعش
        const sub=document.getElementById("gameSubmitted");
        if(sub){ const ans=room.answers||{}; sub.innerHTML=roomPlayersArr().map(pl=>`<div class="small" style="padding:4px 0">${esc(pl.name)} ${ans[pl.id]?"✅ سلّم":"⏳ بيفكر..."}</div>`).join(""); }
      } else if(room.state===prevState && chatCount!==prevChatCount && view==="room"){
        // لو الشات بس اللي اتغير، حدّث الشات من غير ما ترسم كل حاجة
        renderRoomChatOnly(savedChat);
      } else {
        // قبل الرسم الكامل: احفظ هل مربع الشات كان متفعل ومكان المؤشر - عشان نرجعه بعد الرسم والكيبورد ميتقفلش
        const chatInp=document.getElementById("roomChatInp");
        const wasFocused=!!chatInp && document.activeElement===chatInp;
        const selS=chatInp?chatInp.selectionStart:0, selE=chatInp?chatInp.selectionEnd:0;
        render();
        if(view==="room"){ const ni=document.getElementById("roomChatInp"); if(ni){ if(savedChat) ni.value=savedChat; if(wasFocused){ ni.focus(); try{ ni.setSelectionRange(selS, selE); }catch(e){} } } }
      }
      if(room.state==="playing" && view!=="game"){ enterGame(); }
      if(room.state==="result" && view!=="result"){ view="result"; render(); }
      if(room.state==="lobby" && (view==="game" || view==="result")){ view="room"; render(); }
    }
  });
}
function renderRoomChatOnly(saved){
  const box=document.getElementById("roomChatBox"); if(!box || !roomData) return;
  box.innerHTML=chatHTML();
  box.scrollTop=box.scrollHeight;
  const inp=document.getElementById("roomChatInp"); if(inp && saved) inp.value=saved;
}
function getChatEmojis(){
  // v54: ملصقات تعبيرية = الأساسي + اللي اشتريته من المتجر
  const base=["😂","😍","😎","🔥","❤️","👏"];
  const owned=[];
  try{ (EMOJIS||[]).forEach(e=>{ if(me && me.ownedEmojis && me.ownedEmojis[e.id] && !owned.includes(e.emoji) && !base.includes(e.emoji)) owned.push(e.emoji); }); }catch(e){}
  return [...base, ...owned];
}
function chatHTML(){
  const msgs=roomData&&roomData.chat?Object.values(roomData.chat).sort((a,b)=>a.time-b.time).slice(-50):[];
  return msgs.length?msgs.map(m=>{
    const isSticker = m.sticker || (m.text && m.text.trim().length<=4 && ["😂","😍","😎","🤣","😜","😇","😈","😭","😡","🤯","😱","🤔","🥺","😏","🥳","🔥","❤️","👏"].includes(m.text.trim()));
    const body = isSticker ? `<div style="font-size:44px;line-height:1;text-align:center">${esc(m.text||m.sticker||"")}</div>` : linkify(m.text);
    return `<div class="msg ${m.name===me.name?"me":""}"><b>${esc(m.name)}:</b> ${body}<div class="t">${fmtTime(m.time)}</div></div>`;
  }).join(""):'<p class="small center">لسه مفيش رسايل - سلم على صحابك 👋</p>';
}
async function stopRoom(){
  if(roomStop){ roomStop(); roomStop=null; }
  stopHeartbeat(); stopTimer();
  if(roomCode && me && roomData && !roomData.local){
    try{ await fbDel("rooms/"+roomCode+"/players/"+me.id); }catch(e){}
    // لو أنا آخر واحد، امسح الروم
    try{ const r=await fbGet("rooms/"+roomCode); if(r && (!r.players || Object.keys(r.players).length===0)) await fbDel("rooms/"+roomCode); }catch(e){}
  }
  roomCode=null; roomData=null; gameLocal=null;
}
async function leaveRoom(){
  await stopRoom();
  view="home"; render();
}
async function sendRoomChat(){
  const inp=document.getElementById("roomChatInp"); if(!inp) return;
  const txt=inp.value.trim(); if(!txt) return;
  inp.value="";
  if(roomData && roomData.local){ 
    roomData.chat[Date.now()+""]= {name:me.name, text:txt, time:Date.now()};
    renderRoomChatOnly(""); return;
  }
  await fbPost("rooms/"+roomCode+"/chat", {name:me.name, text:txt, time:Date.now()});
}

// ================= Room screen (lobby) =================
function roomHTML(){
  const players=roomPlayersArr();
  const isSolo=roomData && roomData.local;
  const link="ادخل روم أتوبيس معايا! الكود: "+roomCode;
  return `<div class="card"><h2>🏠 روم ${roomCode} ${roomData.mode==="league"?"🏆 دوري":""}</h2>
  <p class="small">الهوست: ${esc(roomData.hostName)} • ${players.length}/10 لاعبين ${roomData.mode==="league"?("• حروف اتلعبت: "+(roomData.usedLetters||[]).length+"/28"):""}</p>
  <div style="display:flex;gap:6px;margin-top:8px"><input readonly value="${roomCode}" style="flex:1;margin:0;text-align:center;font-weight:900;font-size:20px;letter-spacing:4px"><button class="btn btn-green" id="btnCopyCode" style="width:110px;margin:0">📋 انسخ</button><a class="btn btn-green" style="width:110px;margin:0;text-decoration:none;text-align:center" href="https://wa.me/?text=${encodeURIComponent(link)}" target="_blank" rel="noopener">📲 واتساب</a></div>
  ${players.map(pl=>`<div class="shop-item"><div style="display:flex;gap:8px;align-items:center"><span class="avatar-wrap ${pl.frame?("frame-"+pl.frame):""}" style="width:44px;height:44px;font-size:22px">${pl.pic?`<img src="${pl.pic}">`:"👤"}</span><div><b>${esc(pl.name)} ${pl.id===roomData.hostId?"👑":""} ${pl.id===me.id?"(انت)":""}</b><br><small>ID: ${pl.id} • نقاط: ${((roomData.scores||{})[pl.id] ?? pl.score) || 0}</small></div></div>${amHost()&&pl.id!==me.id?`<button class="btn btn-red" style="width:auto;margin:0;padding:8px 10px" data-kick="${pl.id}">طرد ⛔</button>`:""}</div>`).join("")}
  ${amHost()?`<div style="background:#fff3cd;border:2px solid #ffc23d;border-radius:12px;padding:10px;margin-top:10px"><b>🔤 حرف الجولة:</b><select id="selLetter" style="width:100%;margin-top:6px;padding:10px;border-radius:10px;font-weight:900;text-align:center;font-size:16px"><option value="">🎲 عشوائي</option>${ALL_LETTERS.map(L=>`<option value="${L}" ${(roomData.usedLetters||[]).includes(L)?"disabled":""}>${L} ${(roomData.usedLetters||[]).includes(L)?"(اتلعب)":""}</option>`).join("")}</select><p class="small" style="margin:4px 0 0">اختار حرف أو سيبه عشوائي — الحروف اللي اتلعبت مش هتتكرر</p></div><button class="btn btn-green" id="btnStartGame" ${players.length<2?"disabled":""}>▶️ ابدأ الجولة ${players.length<2?"(لازم 2 على الأقل)":""}</button>
  <button class="btn btn-white" id="btnDeleteRoom">🗑️ امسح الروم</button>`:`<p class="small center" style="margin-top:8px">مستني الهوست يبدأ الجولة...</p>`}
  <button class="btn btn-red" id="btnLeaveRoom">🚪 اخرج من الروم</button></div>
  <div class="card"><h3>💬 شات الروم</h3><div class="chat" id="roomChatBox">${chatHTML()}</div>
  <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;align-items:center"><span class="small">💬 ملصقات:</span>${getChatEmojis().map(em=>`<button class="btn btn-white" style="width:auto;margin:0;padding:6px 10px;font-size:18px" data-chat-emoji="${em}">${em}</button>`).join("")}</div>
  <p class="small" style="margin:4px 0 0">الملصق اللي اشتريته بيظهر هنا — دوس عليه يتبعت ملصق كبير في الشات</p>
  <div style="display:flex;gap:6px;margin-top:8px"><input id="roomChatInp" placeholder="اكتب رسالة..." maxlength="200" style="flex:1;margin:0"><button class="btn btn-green" id="btnSendChat" style="width:80px;margin:0">ابعت</button></div></div>`;
}
function bindRoom(){
  const b=(id,fn)=>{ const e=document.getElementById(id); if(e) e.onclick=fn; };
  b("btnCopyCode", ()=>{ try{ navigator.clipboard.writeText(roomCode).then(()=>toast("الكود اتنسخ 📋")); }catch(e){ toast("الكود: "+roomCode); } });
  b("btnLeaveRoom", leaveRoom);
  b("btnSendChat", sendRoomChat);
  const inp=document.getElementById("roomChatInp"); if(inp) inp.onkeydown=(e)=>{ if(e.key==="Enter") sendRoomChat(); };
  // v46: اختيار حرف الجولة للهوست
  const selL=document.getElementById("selLetter"); if(selL){ selL.value=hostLetterChoice||""; selL.onchange=()=>{ hostLetterChoice=selL.value||""; }; }
  // v54: دوس على الملصق يتبعت ملصق كبير على طول
  document.querySelectorAll("[data-chat-emoji]").forEach(btn=>btn.onclick=async ()=>{ const st=btn.dataset.chatEmoji; if(roomData && roomData.local){ roomData.chat[Date.now()+""]={name:me.name, text:st, sticker:st, time:Date.now()}; renderRoomChatOnly(""); return; } await fbPost("rooms/"+roomCode+"/chat", {name:me.name, text:st, sticker:st, time:Date.now()}); });
  if(amHost()){
    b("btnStartGame", ()=>startGame());
    b("btnDeleteRoom", async ()=>{
      if(roomData.local){ roomData=null; roomCode=null; view="home"; render(); return; }
      await fbDel("rooms/"+roomCode); stopRoom(); view="home"; render();
    });
  }
  document.querySelectorAll("[data-kick]").forEach(x=>x.onclick=async ()=>{
    if(roomData.local){ delete roomData.players[x.dataset.kick]; render(); return; }
    await fbDel("rooms/"+roomCode+"/players/"+x.dataset.kick);
    toast("اتطرد");
  });
  setTimeout(()=>{ const w=document.getElementById("roomChatBox"); if(w) w.scrollTop=w.scrollHeight; }, 60);
}

// ================= Solo =================
function startSolo(){
  const bots=[
    {id:"bot1", name:BOT_NAMES[Math.floor(Math.random()*BOT_NAMES.length)], pic:"", emoji:BOT_PICS[0], frame:"", score:0, joinedAt:Date.now()+1, lastSeen:Date.now(), isBot:true},
    {id:"bot2", name:BOT_NAMES[Math.floor(Math.random()*BOT_NAMES.length)], pic:"", emoji:BOT_PICS[1], frame:"", score:0, joinedAt:Date.now()+2, lastSeen:Date.now(), isBot:true},
  ];
  roomData={local:true, code:"SOLO", hostId:me.id, hostName:me.name, createdAt:Date.now(), state:"lobby", mode:"classic", letter:"", secs:60, startedAt:0, answers:{}, review:null, scores:{[me.id]:0, bot1:0, bot2:0}, usedLetters:[], players:{[me.id]:playerObj(), bot1:bots[0], bot2:bots[1]}, chat:{}};
  roomCode="SOLO"; view="room"; render(); toast("روم سولو 🎉 - انت + 2 وهميين");
}

// ================= Game =================
function startGame(){
  const players=roomPlayersArr();
  if(players.length<2) return toast("لازم 2 لاعبين على الأقل");
  // v46: الهوست يختار حرف الجولة أو عشوائي
  let letter="";
  if(hostLetterChoice && ALL_LETTERS.includes(hostLetterChoice) && !(roomData.usedLetters||[]).includes(hostLetterChoice)) letter=hostLetterChoice;
  else letter=randLetter(roomData.usedLetters||[]);
  hostLetterChoice="";
  const used=[...(roomData.usedLetters||[]), letter];
  curLetter=letter;
  if(roomData.local){
    roomData.state="playing"; roomData.letter=letter; roomData.startedAt=Date.now(); roomData.secs=60; roomData.answers={}; roomData.review=null; roomData.usedLetters=used;
    enterGame();
  } else {
    fbPatch("rooms/"+roomCode, {state:"playing", letter, secs:60, startedAt:Date.now(), answers:{}, review:null, usedLetters:used});
  }
}
function enterGame(){
  curLetter=roomData.letter;
  gameLocal={answers:{}, powersUsed:{}, submitted:false, myExtra:0};
  view="game"; render(); startTimer();
}
function stopTimer(){ if(timerInt){ clearInterval(timerInt); timerInt=null; } }
function startTimer(){
  stopTimer();
  timerInt=setInterval(async ()=>{
    if(!roomData || roomData.state!=="playing"){ stopTimer(); return; }
    const el=document.getElementById("gameTimer"); if(!el) return;
    const totalMs=roomData.secs*1000 + (roomData.extraTime||0); // + وقت القوى اللي اتستخدمت
    const deadline=roomData.startedAt + totalMs; // الجولة بتنتهي أول ما الوقت يخلص - من غير سماح
    const left=Math.max(0, Math.ceil((roomData.startedAt + totalMs - Date.now())/1000));
    el.textContent=left+" ث";
    el.style.color= left<=10 ? "#e23b2e" : "#241a12";
    // الوقت خلص: سلّم اللي كتبته أوتوماتيك - اللي ملحقتش تكتبه يتحسب فاضي
    if(Date.now()>deadline){
      stopTimer();
      await submitGame(true); // سلّم إجاباتي الأول عشان اللي كتبته يتحسب
      if(amHost() || roomData.local){
        if(roomData.local) finishGameLocal(); else finishGame();
      }
      return;
    }
    // الهوست بينهي الجولة لو الكل سلّم بدري
    if(amHost() || (roomData.local)){
      const answers=roomData.answers||{};
      const players=roomPlayersArr();
      const allDone = players.length>0 && players.every(pl=> answers[pl.id]);
      if(allDone){
        stopTimer();
        if(roomData.local) finishGameLocal(); else finishGame();
      }
    }
  }, 500);
}
function gameHTML(){
  const answers=roomData.answers||{};
  const players=roomPlayersArr();
  const submittedCount=players.filter(pl=>answers[pl.id]).length;
  return `<div class="card"><div style="display:flex;justify-content:space-between;align-items:center"><b>🎮 جولة ${roomData.mode==="league"?"دوري 🏆":""}</b><span class="pill">سلّم: ${submittedCount}/${players.length}</span></div>
  <div class="letter-big">${roomData.letter}</div>
  <div class="timer" id="gameTimer">${roomData.secs} ث</div>
  <p class="small center">اكتب إجابة بتبدأ بحرف <b>${roomData.letter}</b> في كل خانة</p>
  ${CATS.map(c=>`<label>${c.label}</label><input id="ans_${c.key}" placeholder="${c.label} بحرف ${roomData.letter}..." maxlength="40" value="${esc((gameLocal&&gameLocal.answers[c.key])||"")}">`).join("")}
  <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px">
    <button class="btn btn-white" style="width:auto;flex:1" id="btnPDouble">×2 ضاعف (${(me.powers||{}).double||0}) ${gameLocal.powersUsed.double?"✅":""}</button>
    <button class="btn btn-white" style="width:auto;flex:1" id="btnPTime">+15 ث (${(me.powers||{}).time||0}) ${gameLocal.powersUsed.time?"✅":""}</button>
    <button class="btn btn-white" style="width:auto;flex:1" id="btnPShield">🛡️ درع (${(me.powers||{}).shield||0}) ${gameLocal.powersUsed.shield?"✅":""}</button>
    <button class="btn btn-white" style="width:auto;flex:1" id="btnPHint">💡 تلميح (${(me.powers||{}).hint||0})</button>
  </div>
  <button class="btn btn-green" id="btnSubmitAns" ${gameLocal.submitted?"disabled":""}>${gameLocal.submitted?"✅ اتسلمت - مستني الباقي":"✅ سلّم إجاباتك"}</button>
  <p class="small center" style="margin-top:6px">لما الكل يسلّم أو الوقت يخلص، النتيجة بتظهر أوتوماتيك</p></div>
  <div class="card"><h3>👥 اللي سلّموا</h3><div id="gameSubmitted">${players.map(pl=>`<div class="small" style="padding:4px 0">${esc(pl.name)} ${answers[pl.id]?"✅ سلّم":"⏳ بيفكر..."}</div>`).join("")}</div></div>`;
}
function bindGame(){
  CATS.forEach(c=>{
    const el=document.getElementById("ans_"+c.key);
    if(el) el.oninput=()=>{ gameLocal.answers[c.key]=el.value; };
  });
  const usePower=async (key)=>{
    if(gameLocal.powersUsed[key]) return toast("استخدمتها قبل كده في الجولة دي");
    if(((me.powers||{})[key]||0)<=0) return toast("معندكش القوة دي - اشتريها من المتجر");
    if(key==="hint"){
      // املأ أول خانة فاضية بإجابة جاهزة
      let filled=false;
      for(const c of CATS){
        const cur=(gameLocal.answers[c.key]||"").trim();
        if(!cur){ const v=getBankValue(roomData.letter, c.key); if(v){ gameLocal.answers[c.key]=v; const el=document.getElementById("ans_"+c.key); if(el) el.value=v; filled=true; } break; }
      }
      if(!filled) return toast("مفيش خانة فاضية");
    }
    if(key==="time"){ gameLocal.myExtra=15000; roomData.extraTime=(roomData.extraTime||0)+15000; if(!roomData.local) await fbPatch("rooms/"+roomCode, {extraTime:roomData.extraTime}); toast("⏱️ +15 ثانية للجولة"); }
    if(key==="double") toast("🔥 ×2 اتفعل - نقاطك هتتضاعف");
    if(key==="shield") toast("🛡️ الدرع اتفعل - محدش هيخصم منك");
    gameLocal.powersUsed[key]=true;
    me.powers[key]--;
    await fbPatch("profiles/"+me.id, {powers:me.powers});
    render();
  };
  const b=(id,fn)=>{ const e=document.getElementById(id); if(e) e.onclick=fn; };
  b("btnPDouble", ()=>usePower("double")); b("btnPTime", ()=>usePower("time")); b("btnPShield", ()=>usePower("shield")); b("btnPHint", ()=>usePower("hint"));
  b("btnSubmitAns", ()=>submitGame());
}
let submitPromise=null; // عشان التسليم التلقائي واليدوي ميضربوش بعض
async function submitGame(silent){
  if(!gameLocal || gameLocal.submitted) return;
  if(submitPromise) return submitPromise;
  submitPromise=(async ()=>{
    const answers={}; CATS.forEach(c=>{ answers[c.key]=(gameLocal.answers[c.key]||"").trim(); });
    if(roomData.local){
      roomData.answers[me.id]={answers, powers:gameLocal.powersUsed};
      // الوهميين بيجاوبوا على طول
      roomPlayersArr().forEach(pl=>{
        if(pl.isBot && !roomData.answers[pl.id]){
          const ba={}; CATS.forEach(c=>{ ba[c.key]= Math.random()<0.95 ? getBankValue(roomData.letter, c.key) : ""; });
          roomData.answers[pl.id]={answers:ba, powers:{}};
        }
      });
      gameLocal.submitted=true; if(!silent) toast("✅ اتسلمت"); render(); return;
    }
    let ok=await fbPatch("rooms/"+roomCode+"/answers/"+me.id, {answers, powers:gameLocal.powersUsed});
    if(!ok) ok=await fbPatch("rooms/"+roomCode+"/answers/"+me.id, {answers, powers:gameLocal.powersUsed}); // محاولة تانية
    if(!ok) return toast("مش عارف يسلّم - اتأكد من النت 📶");
    gameLocal.submitted=true; toast(silent?"⏰ الوقت خلص - اتسلم اللي كتبته ✅":"✅ اتسلمت - مستني الباقي"); render();
  })();
  try{ await submitPromise; }finally{ submitPromise=null; }
}
async function finishGame(){
  if(!roomData || roomData.state!=="playing") return;
  let fresh=await fbGet("rooms/"+roomCode);
  if(!fresh || fresh.state!=="playing") return;
  // استنى ثانية لو حد لسه إجاباته موصلتش (النت بطيء) - عشان اللي كتبه يتحسب
  let answers=fresh.answers||{};
  const players0=Object.values(fresh.players||{});
  if(players0.some(pl=>!answers[pl.id])){
    await new Promise(r=>setTimeout(r, 1000));
    const fresh2=await fbGet("rooms/"+roomCode);
    if(!fresh2 || fresh2.state!=="playing") return; // حد تاني أنهى الجولة في النص
    fresh=fresh2; answers=fresh.answers||{};
  }
  const players=Object.values(fresh.players||{});
  const allAnswers=players.map(pl=> (answers[pl.id]||{answers:{}}).answers||{});
  const review=[]; const scores={...(fresh.scores||{})};
  for(const pl of players){
    const mine=answers[pl.id]||{answers:{}, powers:{}};
    const r=calcScore(mine.answers||{}, allAnswers, mine.powers||{});
    scores[pl.id]=(scores[pl.id]||0)+r.score;
    review.push({id:pl.id, name:pl.name, answers:mine.answers||{}, breakdown:r.breakdown, roundScore:r.score, powers:mine.powers||{}});
  }
  const myRev=review.find(r=>r.id===me.id);
  // v46 FIX 1: زامن نقاط اللاعبين مع النقاط التراكمية - عشان اللوبي يعرض النقاط صح مش 0
  const updatedPlayers={...(fresh.players||{})};
  for(const pl of players){ if(updatedPlayers[pl.id]) updatedPlayers[pl.id]={...updatedPlayers[pl.id], score: scores[pl.id]||0}; }
  await fbPatch("rooms/"+roomCode, {state:"result", review, scores, players: updatedPlayers});
  // إحصائياتي
  const top=Object.entries(scores).sort((a,b)=>b[1]-a[1])[0];
  me.stats=me.stats||{games:0,wins:0,totalScore:0,bestScore:0};
  me.stats.games++; me.stats.totalScore+= (myRev?myRev.roundScore:0);
  if((myRev?myRev.roundScore:0)>(me.stats.bestScore||0)) me.stats.bestScore=myRev.roundScore;
  if(top && top[0]===me.id) me.stats.wins++;
  await fbPatch("profiles/"+me.id, {stats:me.stats});
  playSound(top && top[0]===me.id ? "win":"lose");
}
function finishGameLocal(){
  if(!roomData || roomData.state!=="playing") return;
  const players=roomPlayersArr();
  const answers=roomData.answers||{};
  const allAnswers=players.map(pl=> (answers[pl.id]||{answers:{}}).answers||{});
  const review=[]; const scores={...(roomData.scores||{})};
  for(const pl of players){
    const mine=answers[pl.id]||{answers:{}, powers:{}};
    const r=calcScore(mine.answers||{}, allAnswers, mine.powers||{});
    scores[pl.id]=(scores[pl.id]||0)+r.score;
    review.push({id:pl.id, name:pl.name, answers:mine.answers||{}, breakdown:r.breakdown, roundScore:r.score, powers:mine.powers||{}});
  }
  // v46 FIX 1 local: زامن نقاط اللاعبين
  for(const pl of players){ if(roomData.players && roomData.players[pl.id]) roomData.players[pl.id].score = scores[pl.id]||0; }
  roomData.review=review; roomData.scores=scores; roomData.state="result";
  const top=Object.entries(scores).sort((a,b)=>b[1]-a[1])[0];
  me.stats=me.stats||{games:0,wins:0,totalScore:0,bestScore:0};
  const myRev=review.find(r=>r.id===me.id);
  me.stats.games++; me.stats.totalScore+= (myRev?myRev.roundScore:0);
  if((myRev?myRev.roundScore:0)>(me.stats.bestScore||0)) me.stats.bestScore=myRev.roundScore;
  if(top && top[0]===me.id) me.stats.wins++;
  fbPatch("profiles/"+me.id, {stats:me.stats});
  playSound(top && top[0]===me.id ? "win":"lose");
  view="result"; render();
}

// ================= Result =================
function resultHTML(){
  const review=roomData.review||[];
  const scores=roomData.scores||{};
  const sorted=[...review].sort((a,b)=>(scores[b.id]||0)-(scores[a.id]||0));
  const canJudge=amHost(); // الهوست بس - في الأونلاين ولوحده
  return `<div class="card"><h2>🏁 نتيجة الجولة ${roomData.mode==="league"?"🏆 دوري":""}</h2>
  <p class="small">حرف الجولة: <b>${roomData.letter}</b></p>
  ${canJudge?`<p class="small" style="background:#fff3cd;border:1px solid #ffc23d;border-radius:10px;padding:8px">👨‍⚖️ انت الهوست - دوس <b>✅ صح</b> أو <b>❌ غلط</b> جنب أي إجابة عشان تحكم عليها، والنتيجة هتتعدل لكل اللاعبين</p>`:""}
  ${sorted.map((r,i)=>`<div style="background:#fff;border:2px solid ${i===0?"#ffb800":"#f0e0c8"};border-radius:14px;padding:10px;margin-top:8px">
  <b>${i===0?"👑 ":""}${esc(r.name)} ${r.id===me.id?"(انت)":""}</b> - <b>${scores[r.id]||0} نقطة</b> <span class="small">(الجولة دي: +${r.roundScore})</span>
  ${(r.powers&&Object.keys(r.powers).length)?`<div class="small">قوى: ${r.powers.double?"×2 ": ""}${r.powers.shield?"🛡️ ": ""}${r.powers.time?"+15ث ": ""}${r.powers.hint?"💡":""}</div>`:""}
  ${r.breakdown.map((b,bi)=>`<div class="ans-row"><span>${b.label}: ${esc(b.answer)}</span><b class="${b.pts>0?"":"bad"}">${b.pts>0?("+"+b.pts+(b.status==="hostCorrect"?" 👨‍⚖️":"")+(b.savedByShield?" 🛡️ الدرع حماك":"")):(b.status==="wrong"?"0 - مش بحرف "+roomData.letter:(b.status==="similar"?"متشابه":(b.status==="hostWrong"?"0 - الهوست حسبها غلط 👨‍⚖️":"فاضي")))}</b>${canJudge?`<button class="btn ${b.pts>0?"btn-red":"btn-green"}" style="width:auto;margin:0;padding:6px 12px;font-size:13px" data-judge="${review.indexOf(r)}:${bi}:${b.pts>0?0:1}">${b.pts>0?"❌ غلط":"✅ صح"}</button>`:""}</div>`).join("")}
  </div>`).join("")}
  ${amHost()?`<button class="btn btn-green" id="btnNextRound">▶️ ${roomData.mode==="league"?"الجولة اللي بعدها":"جولة تانية"}</button>
  ${roomData.mode==="league"?`<button class="btn btn-purple" id="btnFinishLeague">🏆 إنهاء الدوري وحفظ النتائج</button>`:""}`:`<p class="small center" style="margin-top:8px">مستني الهوست يبدأ الجولة اللي بعدها...</p>`}
  <button class="btn btn-red" id="btnLeaveRoom2">🚪 اخرج من الروم</button></div>`;
}
function bindResult(){
  const b=(id,fn)=>{ const e=document.getElementById(id); if(e) e.onclick=fn; };
  b("btnLeaveRoom2", leaveRoom);
  // تحكيم الهوست: احتساب أي إجابة صح أو غلط - وتتعدل النتيجة لكل اللاعبين
  document.querySelectorAll("[data-judge]").forEach(btn=>btn.onclick=async ()=>{
    const parts=btn.dataset.judge.split(":"); const pi=+parts[0], bi=+parts[1], want=+parts[2];
    const review=roomData.review||[]; const r=review[pi]; if(!r || !r.breakdown || !r.breakdown[bi]) return;
    const bd=r.breakdown[bi];
    const dbl=r.powers&&r.powers.double;
    const newPts=want?(dbl?20:10):0;
    const oldRound=r.roundScore||0;
    bd.pts=newPts; bd.status=want?"hostCorrect":"hostWrong";
    const newRound=r.breakdown.reduce((s,x)=>s+(x.pts||0),0);
    const scores={...(roomData.scores||{})};
    scores[r.id]=(scores[r.id]||0)-oldRound+newRound;
    r.roundScore=newRound;
    if(roomData.local){ roomData.scores=scores; render(); return; }
    // v46: لما الهوست يحكّم - زامن نقاط اللاعب كمان
    const updPlayers2={...(roomData.players||{})};
    if(updPlayers2[r.id]) updPlayers2[r.id]={...updPlayers2[r.id], score: scores[r.id]||0};
    const ok=await fbPatch("rooms/"+roomCode, {review, scores, players: updPlayers2});
    if(!ok) return toast("ماتحفظش - اتأكد من النت 📶");
    toast(want?"✅ اتحسبت صح":"❌ اتحسبت غلط");
    render();
  });
  if(amHost()){
    b("btnNextRound", async ()=>{
      if(roomData.local){ roomData.state="lobby"; roomData.review=null; roomData.answers={}; view="room"; render(); return; }
      await fbPatch("rooms/"+roomCode, {state:"lobby", review:null, answers:{}});
    });
    b("btnFinishLeague", async ()=>{
      const myScore=(roomData.scores||{})[me.id]||0;
      if(roomData.local){ await fbPost("leagueBoard", {name:me.name, score:myScore, time:Date.now()}); toast("🏆 نتيجتك اتسجلت في لوحة الدوري"); await leaveRoom(); view="leagueBoard"; render(); return; }
      await fbPost("leagueBoard", {name:me.name, score:myScore, time:Date.now()});
      await fbPatch("rooms/"+roomCode, {state:"lobby"});
      toast("🏆 نتيجتك اتسجلت"); view="leagueBoard"; render();
    });
  }
}

// ================= League board =================
function leagueBoardHTML(){
  const list=leagueCache.slice().sort((a,b)=>b.score-a.score).slice(0,20);
  return `<div class="card"><h2>🏆 لوحة الدوري</h2><p class="small">أعلى نتائج الدوري من كل اللاعبين</p>
  ${list.length?list.map((e,i)=>`<div class="shop-item"><div><b>${i===0?"👑 ":i+1+". "}${esc(e.name)}</b><br><small>${fmtTime(e.time)}</small></div><b>${e.score} نقطة</b></div>`).join(""):'<p class="small" style="margin-top:8px">لسه مفيش نتائج - العب دوري وسجّل نتيجتك</p>'}
  </div><button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button>`;
}
function bindLeagueBoard(){
  document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
  fbGet("leagueBoard").then(d=>{ const a=objToArr(d); if(JSON.stringify(a)!==JSON.stringify(leagueCache)){ leagueCache=a; if(view==="leagueBoard") render(); } }).catch(()=>{});
}

// ================= Banned =================
function bannedHTML(){
  return `<div class="card" style="background:#ffe8e8;border:2px solid #e23b2e"><h2>🔴 حسابك محظور</h2>
  <p>مش هتقدر تلعب لحد: <b>${myBan?new Date(myBan.until).toLocaleDateString("ar-EG")+" "+new Date(myBan.until).toLocaleTimeString("ar-EG",{hour:"2-digit",minute:"2-digit"}):""}</b></p>
  <p class="small">السبب: ${myBan?esc(myBan.reason||""): ""}</p>
  <p class="small">لو شايف إن ده غلط، ابعت للمالك على الإيميل اللي تحت 📧</p>
  <a href="mailto:${EMAIL}" style="display:block;text-align:center;background:#0b5cff;color:#fff;font-weight:900;border-radius:12px;padding:12px;margin-top:10px;text-decoration:none">📧 ${EMAIL}</a>
  <button class="btn btn-white" id="btnLogoutBan">🚪 خروج</button></div>`;
}
function bindBanned(){
  document.getElementById("btnLogoutBan").onclick=()=>{ me=null; myBan=null; saveSession(); view="auth"; render(); };
}

// ================= Render + streams =================
let updStop=null;
function render(){
  const app=document.getElementById("app"); if(!app) return;
  // بث التحديثات: شغّله بس وانت جوه صفحة التحديثات، ووقّفه لما تخرج
  if(view!=="updates" && updStop){ updStop(); updStop=null; }
  if(!me){ app.innerHTML=authHTML(); bindAuth(); return; }
  if(view==="banned"){ app.innerHTML=bannedHTML(); bindBanned(); return; }
  if(view==="shop"){ app.innerHTML=shopHTML(); bindShop(); return; }
  if(view==="charge"){ app.innerHTML=chargeHTML(); bindCharge(); return; }
  if(view==="orders"){ app.innerHTML=ordersHTML(); bindOrders(); return; }
  if(view==="updates"){
    app.innerHTML=updatesHTML(); bindUpdates();
    if(!updStop) updStop=fbStream("broadcasts", async ()=>{
      const d=await fbGet("broadcasts"); const arr=objToArr(d);
      if(JSON.stringify(arr)!==JSON.stringify(broadcastsCache)){ broadcastsCache=arr; if(view==="updates") render(); }
    });
    return;
  }
  if(view==="report"){ app.innerHTML=reportHTML(); bindReport(); return; }
  if(view==="ownerOrders"){ app.innerHTML=ownerOrdersHTML(); bindOwnerOrders(); return; }
  if(view==="ownerReports"){ app.innerHTML=ownerReportsHTML(); bindOwnerReports(); return; }
  if(view==="ownerPublish"){ app.innerHTML=ownerPublishHTML(); bindOwnerPublish(); return; }
  if(view==="ownerBans"){ app.innerHTML=ownerBansHTML(); bindOwnerBans(); return; }
  if(view==="ownerGifts"){ app.innerHTML=ownerGiftsHTML(); bindOwnerGifts(); return; }
  if(view==="players"){ if(!isOwner()){ view="home"; render(); return; } app.innerHTML=playersHTML(); bindPlayers(); return; }
  if(view==="recover"){ app.innerHTML=recoverHTML(); bindRecover(); return; }
  if(view==="leagueBoard"){ app.innerHTML=leagueBoardHTML(); bindLeagueBoard(); return; }
  if(view==="room"){
    if(!roomData){ view="home"; render(); return; }
    app.innerHTML=roomHTML(); bindRoom(); return;
  }
  if(view==="game"){
    if(!roomData || roomData.state!=="playing"){ view="room"; render(); return; }
    app.innerHTML=gameHTML(); bindGame(); return;
  }
  if(view==="result"){
    if(!roomData || roomData.state!=="result"){ view="room"; render(); return; }
    app.innerHTML=resultHTML(); bindResult(); return;
  }
  app.innerHTML=homeHTML(); bindHome();
}


  // ================= v55: قائمة اللاعبين =================
  let playersCache=[];
  function playersHTML(){
    const list = playersCache.length?playersCache:[];
    return `<div class="card"><h2>👥 اللاعبين - ${list.length} لاعب</h2><p class="small">كل اللي حملوا التطبيق وعملوا حساب - الاسم والـ ID بس، من غير كلمة سر.</p>
    <div style="display:flex;gap:6px;margin:10px 0"><input id="inpSearchPlayer" placeholder="دور بالاسم أو الـ ID..." style="flex:1;margin:0"><button class="btn btn-green" id="btnRefreshPlayers" style="width:100px;margin:0">🔄 تحديث</button></div>
    <div id="playersList">${list.length?list.map(p=>`<div class="shop-item"><div style="display:flex;gap:8px;align-items:center"><span class="avatar-wrap ${p.frame?("frame-"+p.frame):""}" style="width:44px;height:44px;font-size:20px">${p.pic?`<img src="${p.pic}">`:"👤"}</span><div><b>${esc(p.name||"بدون اسم")}</b><br><small>ID: <b>${esc(p.id||"")}</b> • 🪙 ${p.coins||0} • 🎮 ${(p.stats||{}).games||0} جولة</small></div></div><button class="btn btn-white" style="width:auto;margin:0;padding:6px 10px;font-size:12px" data-copy-id="${esc(p.id||"")}">📋 انسخ ID</button></div>`).join(""):'<p class="small center">لسه مفيش لاعبين أو بيحمل...</p>'}</div>
    </div><button class="btn btn-white" id="btnBack">⬅️ رجوع للرئيسية</button></div>`;
  }
  async function bindPlayers(){
    document.getElementById("btnBack").onclick=()=>{ view="home"; render(); };
    document.getElementById("btnRefreshPlayers").onclick=async ()=>{
      const d=await fbGet("profiles"); const arr=objToArr(d).filter(p=>p && p.id && p.name);
      playersCache=arr.sort((a,b)=>String(a.name||"").localeCompare(String(b.name||""), "ar"));
      view="players"; render();
    };
    document.getElementById("inpSearchPlayer").oninput=(e)=>{
      const q=String(e.target.value||"").trim().toLowerCase();
      const filtered = !q ? playersCache : playersCache.filter(p=> String(p.name||"").toLowerCase().includes(q) || String(p.id||"").includes(q));
      const box=document.getElementById("playersList");
      if(box) box.innerHTML = filtered.length?filtered.map(p=>`<div class="shop-item"><div style="display:flex;gap:8px;align-items:center"><span class="avatar-wrap ${p.frame?("frame-"+p.frame):""}" style="width:44px;height:44px;font-size:20px">${p.pic?`<img src="${p.pic}">`:"👤"}</span><div><b>${esc(p.name||"بدون اسم")}</b><br><small>ID: <b>${esc(p.id||"")}</b> • 🪙 ${p.coins||0} • 🎮 ${(p.stats||{}).games||0} جولة</small></div></div><button class="btn btn-white" style="width:auto;margin:0;padding:6px 10px;font-size:12px" data-copy-id="${esc(p.id||"")}">📋 انسخ ID</button></div>`).join(""):'<p class="small center">مفيش نتيجة</p>';
      document.querySelectorAll("[data-copy-id]").forEach(b=>b.onclick=()=>{ try{ navigator.clipboard.writeText(b.dataset.copyId).then(()=>toast("الـ ID اتنسخ 📋")); }catch(e){ toast("ID: "+b.dataset.copyId); } });
    };
    document.querySelectorAll("[data-copy-id]").forEach(b=>b.onclick=()=>{ try{ navigator.clipboard.writeText(b.dataset.copyId).then(()=>toast("الـ ID اتنسخ 📋")); }catch(e){ toast("ID: "+b.dataset.copyId); } });
    if(!playersCache.length){
      const d=await fbGet("profiles"); const arr=objToArr(d).filter(p=>p && p.id && p.name);
      playersCache=arr.sort((a,b)=>String(a.name||"").localeCompare(String(b.name||""), "ar"));
      const box=document.getElementById("playersList");
      if(box) { view="players"; render(); }
    }
  }
  // ================= v55: استرجاع الحساب =================
  let recoverFound=null;
  function recoverHTML(){
    return `<div class="card"><h2>🔑 نسيت كلمة السر؟</h2><p class="small">لو معاك الـ ID بتاعك هترجع حسابك لوحدك في ثانية. لو نسيت الـ ID كمان، ابعت للمالك باسم الحساب.</p>
    <div style="background:#e6ffe6;border:2px solid #2ecc71;border-radius:14px;padding:12px;margin:10px 0"><b>1) معاك الـ ID؟</b><p class="small">اكتب الـ ID بتاعك (6 أرقام) وهنعرضلك كلمة السر وتقدر تغيرها.</p>
    <label>🆔 الـ ID بتاعك</label><input id="recIdCheck" placeholder="اكتب الـ ID - 6 أرقام" maxlength="6" inputmode="numeric" value="${recoverFound?esc(recoverFound.id):""}">
    <button class="btn btn-green" id="btnCheckId">🔍 اعرض كلمة السر</button>
    <div id="recIdResult">${recoverFound?`<div style="background:#fff;border:2px solid #2ecc71;border-radius:12px;padding:10px;margin-top:10px"><b>✅ لقينا حسابك:</b><br><div style="display:flex;gap:8px;align-items:center;margin:8px 0"><span class="avatar-wrap ${recoverFound.frame?("frame-"+recoverFound.frame):""}" style="width:48px;height:48px;font-size:22px">${recoverFound.pic?`<img src="${recoverFound.pic}">`:"👤"}</span><div><b>${esc(recoverFound.name)}</b><br><small>ID: <b>${recoverFound.id}</b></small></div></div><p class="small">🔒 كلمة السر الحالية: <b style="font-size:16px">${esc(recoverFound.pass||"")}</b></p><label>🔒 كلمة سر جديدة (لو عايز تغيرها)</label><input id="recNewPass" type="password" placeholder="اكتب كلمة سر جديدة" maxlength="30"><button class="btn btn-green" id="btnDoChangePass">✅ غيّر كلمة السر وادخل</button></div>`:''}</div></div>
    <div style="background:#eaf7ff;border:2px solid #0b5cff;border-radius:14px;padding:12px;margin:10px 0"><b>2) نسيت الـ ID كمان؟</b><p class="small">ابعت للمالك على البريد <b>باسم الحساب بتاعك</b>، وهو هيدخل لقايمة اللاعبين من حسابه ويبعتلك بياناتك.</p>
    <label>👤 اسم الحساب بتاعك</label><input id="recNameForMail" placeholder="اكتب اسم حسابك" maxlength="20">
    <a id="btnMailRecover" href="mailto:${EMAIL}?subject=نسيت كلمة السر والـ ID - أتوبيس" style="display:block;text-align:center;background:#0b5cff;color:#fff;font-weight:900;border-radius:12px;padding:12px;margin-top:10px;text-decoration:none">📧 ابعت للمالك على البريد</a>
    <p class="small center" style="margin:6px 0 0">${EMAIL}</p><button class="btn btn-white" id="btnCopyEmailRecover" style="margin-top:6px">📋 انسخ البريد</button></div>
    <button class="btn btn-white" id="btnBack">⬅️ رجوع للدخول</button></div>`;
  }
  async function bindRecover(){
    document.getElementById("btnBack").onclick=()=>{ recoverFound=null; view="auth"; render(); };
    const copyBtn=document.getElementById("btnCopyEmailRecover");
    if(copyBtn) copyBtn.onclick=()=>{ try{ navigator.clipboard.writeText(EMAIL).then(()=>toast("البريد اتنسخ 📋")); }catch(e){ toast("البريد: "+EMAIL); } };
    const updMail=()=>{ const n=String(document.getElementById("recNameForMail")?.value||"").trim(); const a=document.getElementById("btnMailRecover"); if(a){ const body="نسيت كلمة السر والـ ID:%0A%0Aاسم الحساب: "+encodeURIComponent(n)+"%0A"; a.href="mailto:"+EMAIL+"?subject="+encodeURIComponent("نسيت كلمة السر والـ ID - أتوبيس")+"&body="+body; } };
    const rn=document.getElementById("recNameForMail"); if(rn) rn.oninput=updMail;
    document.getElementById("btnCheckId").onclick=async ()=>{
      const id=String(document.getElementById("recIdCheck").value||"").trim();
      if(!id) return toast("اكتب الـ ID الأول");
      if(id.length!==6) return toast("الـ ID لازم 6 أرقام");
      const p=await fbGet("profiles/"+id);
      if(!p || !p.id) return toast("مفيش حساب بالـ ID ده - اتأكد من الرقم أو ابعت للمالك بالبريد تحت");
      recoverFound=p; view="recover"; render(); toast("✅ لقينا حسابك");
    };
    const btnCh=document.getElementById("btnDoChangePass");
    if(btnCh) btnCh.onclick=async ()=>{
      const np=String(document.getElementById("recNewPass").value||"").trim();
      if(np.length<3) return toast("كلمة السر الجديدة لازم 3 حروف على الأقل");
      if(!recoverFound) return toast("اكتب الـ ID الأول");
      await fbPatch("profiles/"+recoverFound.id, {pass:np});
      me={...recoverFound, pass:np}; saveSession(); recoverFound=null; view="home"; render(); toast("✅ كلمة السر اتغيرت ودخلت حسابك");
    };
  }
  // ================= Init =================
async function init(){
  window.__forceOpen=()=>{ try{ view="auth"; render(); }catch(e){ document.getElementById("app").innerHTML='<div class="card center"><h2>🚌 أتوبيس</h2><p>افتح الملف من Chrome مش من عارض الملفات.</p><button class="btn btn-green" onclick="location.reload()">🔄 حاول تاني</button></div>'; } };
  setTimeout(()=>{ try{ const app=document.getElementById("app"); if(app && app.innerHTML.includes("بيحمّل")){ view="auth"; render(); } }catch(e){} }, 4000);
  try{ const v=await fbGet("version"); if(v){ versionInfo=v; netOn=true; } else { netOn=true; } }catch(e){ netOn=false; }
  // بث الطلبات في الخلفية عشان عداد الطلبات الجديدة يوصلك وانت في الرئيسية (للمالك)
  let sess=null;
  try{ sess=JSON.parse(localStorage.getItem("autobus_session_v2")||"null"); }catch(e){}
  // v50: لو الجلسة المحفوظة هي المالك - ادخل فوراً حتى لو السيرفر بطيء، وزامن بعدين
  if(sess && sess.id===HOST_ID){
    me={id:HOST_ID, name:"Hisham", pass:OWNER_PASS, pic:"", emoji:"😎", frame:"", coins:999999, powers:{double:99,time:99,shield:99,hint:99}, ownedFrames:{}, ownedEmojis:{}, stats:{games:0,wins:0,totalScore:0,bestScore:0}, lastGift:"", createdAt:Date.now()};
    try{ const cloud=await fbGet("profiles/"+HOST_ID); if(cloud){ me={...me, ...cloud, id:HOST_ID, name:"Hisham", pass:OWNER_PASS, coins:999999, powers:{double:99,time:99,shield:99,hint:99}}; } }catch(e){}
    try{ (typeof FRAMES!=="undefined"?FRAMES:[]).forEach(f=>{ me.ownedFrames[f.id]=true; }); }catch(e){}
    try{ (typeof EMOJIS!=="undefined"?EMOJIS:[]).forEach(e=>{ me.ownedEmojis[e.id]=true; }); }catch(e){}
    await afterLogin(); return;
  }
  if(sess && sess.id){
    const profile=await fbGet("profiles/"+sess.id);
    if(profile){
      me=profile;
      // تحديث التحديثات في الخلفية عشان العداد
      fbGet("broadcasts").then(d=>{ const a=objToArr(d); if(JSON.stringify(a)!==JSON.stringify(broadcastsCache)){ broadcastsCache=a; if(view==="home") render(); } }).catch(()=>{});
      await afterLogin();
      return;
    }
  }
  view="auth"; render();
}
init();
</script>
</body>
</html>
