// ================= Firebase layer: REST + Streaming (realtime من غير SDK ومن غير apiKey) =================
let lastFbError=""; // آخر خطأ من السيرفر - عشان نعرف سبب الفشل بالظبط
async function fbFetch(path, opts, ms){
  const c = new AbortController();
  const to = setTimeout(()=>{ try{c.abort();}catch(e){} }, ms||9000);
  try{
    const r = await fetch(FB_BASE+"/"+path+".json", {...(opts||{}), signal:c.signal});
    clearTimeout(to);
    if(!r.ok) throw new Error("HTTP "+r.status);
    const txt = await r.text();
    lastFbError="";
    return txt ? JSON.parse(txt) : null;
  }catch(e){ clearTimeout(to); lastFbError=(e&&e.name==="AbortError")?"انتهت المهلة (النت بطيء)":(e&&e.message?e.message:String(e)); throw e; }
}
async function fbGet(path){ try{ return await fbFetch(path, null, 9000); }catch(e){ return null; } }
async function fbPut(path, val){ try{ await fbFetch(path, {method:"PUT", headers:{"Content-Type":"application/json"}, body:JSON.stringify(val==null?null:val)}, 9000); return true; }catch(e){ return false; } }
async function fbPatch(path, val){ try{ await fbFetch(path, {method:"PATCH", headers:{"Content-Type":"application/json"}, body:JSON.stringify(val)}, 9000); return true; }catch(e){ return false; } }
async function fbPost(path, val){ try{ const r = await fbFetch(path, {method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(val)}, 9000); return r && r.name ? r.name : null; }catch(e){ return null; } }
async function fbDel(path){ try{ await fbFetch(path, {method:"DELETE"}, 9000); return true; }catch(e){ return false; } }
// بث لحظي: EventSource من Firebase - أي تغيير في المسار بينادي onChange، ولو فشل بيرجع لـ polling كل 2.5 ثانية
function fbStream(path, onChange){
  let es=null, iv=null, stopped=false;
  const fire=()=>{ if(!stopped) onChange(); };
  try{
    es = new EventSource(FB_BASE+"/"+path+".json");
    const h=()=>fire();
    es.addEventListener("put", h); es.addEventListener("patch", h);
    es.onerror=()=>{ try{es.close();}catch(e){} es=null; if(!stopped && !iv) iv=setInterval(fire, 2500); };
  }catch(e){ iv=setInterval(fire, 2500); }
  return ()=>{ stopped=true; try{if(es) es.close();}catch(e){} if(iv) clearInterval(iv); };
}

// ================= Helpers =================
function esc(s){ return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
function toast(msg){ const w=document.getElementById("toastWrap"); if(!w) return; const d=document.createElement("div"); d.className="toast"; d.textContent=msg; w.appendChild(d); setTimeout(()=>{ d.remove(); }, 3000); }
function todayStr(){ const d=new Date(); return d.getFullYear()+"-"+(d.getMonth()+1)+"-"+d.getDate(); }
function normArabic(s){ return String(s||"").replace(/[أإآ]/g,"ا").replace(/ة/g,"ه").replace(/ى/g,"ي").replace(/[\u064B-\u0652]/g,"").trim(); }
function normLetter(s){ const a=normArabic(s); if(!a) return ""; const c=a[0]; if(c==="ا") return "أ"; if(c==="ه") return "هـ"; return c; }
function fmtTime(ts){ if(!ts) return ""; const d=new Date(ts); return d.toLocaleDateString("ar-EG")+" "+d.toLocaleTimeString("ar-EG",{hour:"2-digit",minute:"2-digit"}); }
function linkify(s){ const e=esc(s); return e.replace(/(https?:\/\/[^\s<]+)/g,'<a href="$1" target="_blank" rel="noopener" style="color:#0b5cff;font-weight:900">$1</a>'); }
let _audioCtx=null;
function playSound(type){
  try{
    if(!soundOn) return;
    if(!_audioCtx) _audioCtx=new (window.AudioContext||window.webkitAudioContext)();
    const o=_audioCtx.createOscillator(), g=_audioCtx.createGain();
    o.connect(g); g.connect(_audioCtx.destination);
    o.type= type==="win"?"sine": type==="wrong"?"sawtooth":"square";
    o.frequency.value= type==="win"?660: type==="wrong"?160:440;
    g.gain.value=0.12; o.start(); o.stop(_audioCtx.currentTime+0.15);
  }catch(e){}
}
function randCode(){ const chars="ABCDEFGHJKMNPQRSTUVWXYZ23456789"; let s=""; for(let i=0;i<4;i++) s+=chars[Math.floor(Math.random()*chars.length)]; return s; }
function randId(){ return String(Math.floor(100000+Math.random()*900000)); }
function randLetter(exclude){
  const pool=ALL_LETTERS.filter(l=>!(exclude||[]).includes(l));
  return pool[Math.floor(Math.random()*pool.length)] || "أ";
}
function getBankValue(letter, key){
  if(key==="country" && COUNTRY_BANK[letter] && COUNTRY_BANK[letter].length){ const a=COUNTRY_BANK[letter]; return a[Math.floor(Math.random()*a.length)]; }
  if(key==="boy" && BOY_BANK[letter] && BOY_BANK[letter].length){ const a=BOY_BANK[letter]; return a[Math.floor(Math.random()*a.length)]; }
  if(key==="girl" && GIRL_BANK[letter] && GIRL_BANK[letter].length){ const a=GIRL_BANK[letter]; return a[Math.floor(Math.random()*a.length)]; }
  if(key==="animal" && ANIMAL_BANK[letter] && ANIMAL_BANK[letter].length){ const a=ANIMAL_BANK[letter]; return a[Math.floor(Math.random()*a.length)]; }
  if(key==="thing" && THING_BANK[letter] && THING_BANK[letter].length){ const a=THING_BANK[letter]; return a[Math.floor(Math.random()*a.length)]; }
  if(key==="plant" && PLANT_BANK[letter] && PLANT_BANK[letter].length){ const a=PLANT_BANK[letter]; return a[Math.floor(Math.random()*a.length)]; }
  if(BANK[letter] && BANK[letter][key]) return BANK[letter][key];
  return "";
}
// حساب النقاط: إجابة صحيحة بحرف الجولة = 10 لوحدك، 5 لو متشابهة، 0 لو غلط أو فاضية. ×2 بيضاعف. الدرع بيحمي من خصم التشابه.
function calcScore(answers, allAnswers, powers){
  let score=0; const breakdown=[];
  CATS.forEach(c=>{
    const a=(answers[c.key]||"").trim();
    const want=normLetter(curLetter);
    let pts=0, status="empty", savedByShield=false;
    if(a && normLetter(a)===want && normArabic(a).length>1){
      let count=0;
      (allAnswers||[]).forEach(o=>{ const oa=(o[c.key]||"").trim(); if(oa && normArabic(oa)===normArabic(a)) count++; });
      const similar = count>1;
      if(similar && !(powers&&powers.shield)){ pts=5; status="similar"; }
      else { pts=10; status="correct"; if(similar) savedByShield=true; }
      score+=pts;
    } else if(a){ status="wrong"; }
    breakdown.push({key:c.key, label:c.label, answer:a||"—", pts, status, savedByShield});
  });
  if(powers&&powers.double){ score*=2; breakdown.forEach(b=>{ b.pts*=2; }); }
  return {score, breakdown};
}

